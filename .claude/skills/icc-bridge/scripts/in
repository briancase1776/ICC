#!/bin/bash
# .claude/skills/icc-bridge/scripts/in
# in DIR SIDE < text: take the text a message carried and put the payload it
# spells on the lanes SIDE writes. Whole or nothing: a character outside the
# alphabet refuses the text, and the wire is untouched.
# Copyright (c) 2026 Brian Case. All rights reserved.
# AI contributor: Claude (Anthropic)
#
# MIT License text omitted for brevity, See LICENCE.TXT
pDir=${1:?usage: in DIR SIDE}; eSide=${2:?usage: in DIR SIDE}
set -eu
pTop=$(cd "$(dirname "$0")/../../../.." && pwd)
pIccFrames=$(cd "$pTop/.claude/skills/icc-frames/scripts" && pwd)
pTemp=$(mktemp)
trap 'rm -f "$pTemp"' EXIT
trap 'trap - EXIT INT TERM HUP; rm -f "$pTemp"; exit 1' INT TERM HUP
base64 -d > "$pTemp" 2>/dev/null ||
  { echo "in: not the alphabet; nothing put on the wire" >&2; exit 1; }
"$pIccFrames/write" "$pDir" "$eSide" < "$pTemp"
