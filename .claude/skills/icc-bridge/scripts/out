#!/bin/bash
##
# @file out
# @brief Take one payload off the lanes SIDE reads and print it as text.
# @details out DIR SIDE. DIR is what Pipes' create printed, or an end in a
#          Patch map. SIDE is 0 or 1, and Frames refuses anything else.
#          The payload comes off by Frames' read, from beside this skill,
#          and is printed in base64, as base64(1) prints it. Whole or
#          nothing: a payload that does not come off whole prints nothing,
#          and Frames says what it left. The temporary goes whichever way
#          the script ends, a timeout's signal included.
# @stdin nothing
# @stdout the payload in base64
# @stderr the reason, on refusal, Frames' included
# @exit 0 the text is out; 1 DIR or SIDE is missing, Frames refused, or
#       the read was cut off
#
# Copyright (c) 2026 Brian Case. All rights reserved.
# AI contributor: Claude (Anthropic)
#
# MIT Licence. See LICENCE.TXT
##
pDir=${1:?usage: out DIR SIDE}
eSide=${2:?usage: out DIR SIDE}
set -eu
source "$(dirname "$0")/../../icc-lib/scripts/lib"
pIccFrames=$(cd "$(dirname "$0")/../../icc-frames/scripts" && pwd)
# The temp file goes however this ends, and a signal ends it with 1.
# Armed before anything is made, as icc-lib's vArm says.
pTemp=
vArm '[ -n "$pTemp" ] && rm -f "$pTemp" || :'
pTemp=$(mktemp)
"$pIccFrames/read" "$pDir" "$eSide" > "$pTemp"
base64 "$pTemp"
