#!/bin/sh
# .claude/skills/icc-bridge/scripts/out
# out DIR SIDE > text: take one payload off the lanes SIDE reads and print it
# in the alphabet a message can carry. Whole or nothing: a payload that does
# not come off whole prints nothing, and Frames says what it left. This
# shell is sh, and sh does not run an EXIT trap when it dies on a signal, so
# the signals a timeout sends are trapped too.
# Copyright (c) 2026 Brian Case. All rights reserved.
# AI contributor: Claude (Anthropic)
#
# MIT License text omitted for brevity, See LICENCE.TXT
set -eu
d=${1:?usage: out DIR SIDE}; s=${2:?usage: out DIR SIDE}
top=$(cd "$(dirname "$0")/../../../.." && pwd)
F=$(cd "$top/.claude/skills/icc-frames/scripts" && pwd)
p=$(mktemp)
trap 'rm -f "$p"' EXIT
trap 'trap - EXIT INT TERM HUP; rm -f "$p"; exit 1' INT TERM HUP
"$F/read" "$d" "$s" > "$p"
base64 "$p"
