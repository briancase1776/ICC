#!/bin/bash
# .claude/skills/icc-bridge/scripts/out
# out DIR SIDE > text: take one payload off the lanes SIDE reads and print it
# in the alphabet a message can carry. Whole or nothing: a payload that does
# not come off whole prints nothing, and Frames says what it left. The
# signals a timeout sends are trapped as well as EXIT, and the signal trap
# clears EXIT before it runs, so the temporary goes exactly once whichever
# way the script ends.
# Copyright (c) 2026 Brian Case. All rights reserved.
# AI contributor: Claude (Anthropic)
#
# MIT License text omitted for brevity, See LICENCE.TXT
pDir=${1:?usage: out DIR SIDE}; eSide=${2:?usage: out DIR SIDE}
set -eu
pTop=$(cd "$(dirname "$0")/../../../.." && pwd)
pIccFrames=$(cd "$pTop/.claude/skills/icc-frames/scripts" && pwd)
pTemp=$(mktemp)
trap 'rm -f "$pTemp"' EXIT
trap 'trap - EXIT INT TERM HUP; rm -f "$pTemp"; exit 1' INT TERM HUP
"$pIccFrames/read" "$pDir" "$eSide" > "$pTemp"
base64 "$pTemp"
