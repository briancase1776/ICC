#!/bin/bash
# .claude/skills/icc-frames/scripts/read
# read DIR SIDE > bytes: take frames off the lanes SIDE reads and put them
# back together. The count comes first. Frames come round-robin, lane order.
# A count that is missing or is not a count is a failure, not an empty
# payload: bytes in, the same bytes out, or say so.
# Copyright (c) 2026 Brian Case. All rights reserved.
# AI contributor: Claude (Anthropic)
#
# MIT License text omitted for brevity, See LICENCE.TXT
set -eu
shopt -s nullglob
d=${1:?usage: read DIR SIDE}; s=${2:?usage: read DIR SIDE}
lanes=("$d"/[0-9]*); n=$(( ${#lanes[@]} / 2 ))
b=$(getconf PIPE_BUF "$d")
r=$(( 1 - s ))
read -r size 0<> "$d/$r" ||
  { echo "read: no count where a payload should start" >&2; exit 1; }
[[ $size =~ ^[0-9]+$ ]] ||
  { echo "read: not a count: $size" >&2; exit 1; }
k=0; left=$size
while (( left > 0 )); do
  (( want = left < b ? left : b ))
  head -c "$want" 0<> "$d/$(( (k % n) * 2 + r ))"
  left=$(( left - want )); k=$(( k + 1 ))
done
