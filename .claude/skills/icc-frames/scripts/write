#!/bin/bash
# .claude/skills/icc-frames/scripts/write
# write DIR SIDE < bytes: slice stdin into frames and put them on the lanes
# SIDE writes. A count goes first. Frames go round-robin, lane order.
# Copyright (c) 2026 Brian Case. All rights reserved.
# AI contributor: Claude (Anthropic)
#
# MIT License text omitted for brevity, See LICENCE.TXT
set -eu
shopt -s nullglob
d=${1:?usage: write DIR SIDE}; s=${2:?usage: write DIR SIDE}
# SIDE before it is used: it ends up in arithmetic, where a subscript is
# evaluated, so anything but 0 or 1 is refused rather than worked out.
case $s in 0|1) ;; *) echo "write: SIDE is 0 or 1, not $s" >&2; exit 1 ;; esac
lanes=("$d"/[0-9]*); n=$(( ${#lanes[@]} / 2 ))
(( n > 0 )) || { echo "write: no lanes in $d" >&2; exit 1; }
# Every lane this side writes, before any of them is opened: `<>` creates,
# so an open that is not already a lane would put a file in the pipe's
# directory, where it outlives the pipe and Pipes' remove refuses it.
for (( j=0; j<n; j++ )); do
  [ -p "$d/$(( j * 2 + s ))" ] ||
    { echo "write: not a lane: $d/$(( j * 2 + s ))" >&2; exit 1; }
done
b=$(getconf PIPE_BUF "$d")

# The count goes in front, so the whole payload is held while it is weighed.
# The hold is a chain of cats, one per lane this side writes, so it is as deep
# as the wire it feeds. Detached on purpose: a chain in this shell's own tree
# holds nothing, because the shell waits for its own pipeline before going on.
h=; c=
# The chain ends itself when the hold is closed, so this is only for a signal
# arriving mid-write. It signals the job, not the shell that forked it: that
# shell is a pipeline's parent, and killing it alone orphans every cat in the
# chain with nothing left able to end them.
release() {
  [ -n "$h" ] && kill -- -"$h" 2>/dev/null || :
  # The counting pair is not in the chain's group: bash gives a process
  # substitution the caller's group whatever job control says, so it has to
  # be taken by name, children first -- tee holds the hold's input open and
  # nothing downstream can end while it does.
  [ -n "$c" ] && { pkill -P "$c" 2>/dev/null; kill "$c" 2>/dev/null; } || :
}
trap 'release; exit 1' INT TERM HUP
trap release EXIT

hold() {
  # Made, opened, and unlinked before anything is written to it: the hold
  # lives on its descriptors alone, so no name survives for a bystander to
  # read or a signal to strand, and there is nothing to clean up.
  local t; t=$(mktemp -d "${TMPDIR:-/tmp}/icc-frames-XXXXXXXX")
  mkfifo -m 600 "$t/i" "$t/o"
  # <> to start with, because it is the open that never blocks and there is
  # nobody at the other end yet.
  exec 3<> "$t/o" 5<> "$t/i"
  # The chain's own ends, and they are one-way on purpose: given a <> dup it
  # would be a writer on its own input and could never see EOF.
  exec 6< "$t/i" 7> "$t/o"
  # Now that each lane has somebody on the far side, take this script's ends
  # one-way too. A <> end is its own reader as well as its own writer, and
  # anything inheriting it can neither be refused nor see EOF: that is what
  # left a killed write's counting pair alive with nothing able to end it.
  exec 5>&-; exec 5> "$t/i"
  exec 3>&-; exec 3< "$t/o"
  rm -f "$t/i" "$t/o"; rmdir "$t"
  # A group is a command with one stdin and one stdout, so the chain's ends
  # are the group's ends: the head reads the group's stdin, the tail writes
  # its stdout, and every stage between is a bare cat. The ends are put on
  # the group and closed in the same breath, so no cat inherits either and
  # every one of them holds nothing but 0, 1 and 2. A stage holding the far
  # end could never see EOF, which is what left fifteen cats behind the
  # first time this was tried; now there is nothing for one to hold. Neither
  # 3 nor 5 goes either, for the same reason, and handing stdout to the hold
  # is what lets go of a caller's $( ).
  # What eval sees is the word cat and a pipe: nothing a caller controls is
  # in it. Its own process group, so one signal reaches the whole chain, and
  # one lane a side needs no special case -- the group is the same shape.
  local cmd k
  cmd="cat"
  for (( k=1; k<n; k++ )); do cmd="$cmd | cat"; done
  set -m
  eval "{ $cmd ; } <&6 >&7 6<&- 7>&- 3>&- 5>&- &"
  h=$!
  set +m
  exec 6<&- 7>&-
}

hold
# The counting pair must not hold the hold's far end. Given fd 3 it is a
# reader on the output as well as a writer on the input, so it pins the ring
# from both sides: the chain's tail blocks instead of being refused, its head
# never sees EOF, and a write that dies without running its trap leaves the
# whole lot alive on descriptors nothing can name.
exec 4< <( exec 3>&-; tee "/dev/fd/5" | wc -c )
c=$!
read -r size <&4; exec 4<&-
c=
# Closing the last writer is what ends the chain: its head opened the hold
# read-only, so it sees EOF, drains what it has, and exits by itself.
exec 5>&-
printf '%s\n' "$size" 1<> "$d/$s"
k=0; left=$size
while (( left > 0 )); do
  (( want = left < b ? left : b ))
  head -c "$want" <&3 1<> "$d/$(( (k % n) * 2 + s ))"
  left=$(( left - want )); k=$(( k + 1 ))
done
wait "$h" || { echo "write: the hold failed" >&2; exit 1; }
h=; c=
