#!/bin/bash
# .claude/skills/icc-frames/scripts/write
# write DIR SIDE < bytes: slice stdin into frames and put them on the lanes
# SIDE writes. A count goes first. Frames go round-robin, lane order.
# Copyright (c) 2026 Brian Case. All rights reserved.
# AI contributor: Claude (Anthropic)
#
# MIT License text omitted for brevity, See LICENCE.TXT
set -eu
shopt -s nullglob
d=${1:?usage: write DIR SIDE}; s=${2:?usage: write DIR SIDE}
lanes=("$d"/[0-9]*); n=$(( ${#lanes[@]} / 2 ))
(( n > 0 )) || { echo "write: no lanes in $d" >&2; exit 1; }
b=$(getconf PIPE_BUF "$d")

# The count goes in front, so the whole payload is spooled while it is
# weighed. Made, opened both ways, and unlinked before a byte is written:
# the spool lives on its descriptors alone, so no name survives for a
# bystander to read or a signal to strand, and there is nothing to clean up.
# The reading end is opened before anything is put there, so it sits at the
# start and the frames come off it in order.
t=$(mktemp "${TMPDIR:-/tmp}/icc-frames-XXXXXXXX")
exec 3> "$t" 4< "$t"
rm -f "$t"
cat >&3; exec 3>&-
size=$(stat -Lc %s /proc/self/fd/4)

printf '%s\n' "$size" 1<> "$d/$s"
k=0; left=$size
while (( left > 0 )); do
  (( want = left < b ? left : b ))
  head -c "$want" <&4 1<> "$d/$(( (k % n) * 2 + s ))"
  left=$(( left - want )); k=$(( k + 1 ))
done
