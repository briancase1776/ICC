#!/bin/bash
##
# @file write
# @brief Slice stdin into frames and put them on the lanes SIDE writes.
# @details write DIR SIDE. DIR is what Pipes' create printed, and one with
#          an odd lane count is refused. SIDE is 0 or 1, the side this end
#          is: side 0 writes the even lanes, side 1 the odd ones. A count
#          goes first, as a decimal line on the first lane SIDE writes,
#          with the head of the payload in the same page, then frames of
#          PIPE_BUF round-robin in lane order.
#          The whole payload is held while it is counted, in a hold of
#          65536 bytes for each lane SIDE writes and one more. A payload
#          past that is refused before the count goes out, so nothing of
#          it reaches a lane.
# @stdin the payload
# @stdout nothing
# @stderr the reason, on refusal
# @global TMPDIR - read, where the hold is made, and /tmp when unset
# @exit 0 the payload is on the wire; 1 DIR or SIDE is refused, the
#       payload is past the hold, or the hold failed
#
# Copyright (c) 2026 Brian Case. All rights reserved.
# AI contributor: Claude (Anthropic)
#
# MIT Licence. See LICENCE.TXT
##
pDir=${1:?usage: write DIR SIDE}
eSide=${2:?usage: write DIR SIDE}
set -eu
# SIDE before it is used: it ends up in arithmetic, where a subscript is
# evaluated, so anything but 0 or 1 is refused rather than worked out.
case $eSide in
  0|1)
    ;;
  *)
    echo "write: SIDE is 0 or 1, not $eSide" >&2
    exit 1
    ;;
esac
# A pipe is what Pipes makes, and the same checks, in the same order, as Tee's
# and Merge's create: lane 0 first, so a path that is no pipe at all says so;
# then an even count, in Pipes' words; then every lane of it a lane. All
# before any lane is opened: `<>` creates, so an open that is not already a
# lane would put a file in the pipe's directory, where it outlives the pipe
# and Pipes' remove refuses it.
[ -p "$pDir/0" ] || {
  echo "write: not a pipe: $pDir" >&2
  exit 1
}
nLanes=$(ls -- "$pDir" | grep -c '^[0-9][0-9]*$')
case $nLanes in
  *[13579])
    echo "write: lanes must be even: $pDir" >&2
    exit 1
    ;;
esac
iLane=0
while [ "$iLane" -lt "$nLanes" ]; do
  [ -p "$pDir/$iLane" ] || {
    echo "write: not a pipe: $pDir" >&2
    exit 1
  }
  iLane=$((iLane + 1))
done
nPairs=$((nLanes / 2))
nPipeBuf=$(getconf PIPE_BUF "$pDir")
# The hold is nPairs+1 fifos this script makes, and one it makes holds
# 65536 whatever the lanes have been grown to, so what fits is that number
# either way, and it is known before a byte is read.
(( nHold = (nPairs + 1) * 65536 ))

# The count goes in front, so the whole payload is held while it is weighed.
# The hold is a chain of copiers, one per lane this side writes, so it is as
# deep as the wire it feeds. The copier is dd bs=4096 because Pipes says dd
# and not cat: cat holds whatever its read returned, a store whose size
# nobody chose, and the figure above is one this script enforces before the
# count goes out. dd holds a page, so what the chain holds is the pipes in
# it and a page a stage, which leaves that figure a floor under it every
# run. Detached on purpose: a chain in this shell's own tree holds nothing,
# because the shell waits for its own pipeline before going on.
pidChainGroup=
pidCounter=
pHoldDir=

##
# @fn vRelease()
# @brief Take down whatever of the hold and the counting pair is still up.
# @details The chain ends itself when the hold is closed, so this is only
#          for a signal arriving mid-write. It signals the job, not the
#          shell that forked it: that shell is a pipeline's parent, and
#          killing it alone orphans every copier in the chain with
#          nothing left able to end them. Each of the three names below
#          is empty while there is nothing of it to take.
# @stderr nothing
# @global pHoldDir - read, the hold's directory until it is unlinked
# @global pidChainGroup - read, the chain, which leads its own group
# @global pidCounter - read, the subshell running the counting pair
# @return 0
##
vRelease() {
  # The hold's directory outlives a signal that lands before its lanes are
  # unlinked, and that window is the documented `timeout N` usage, so it is
  # named out here where vRelease can reach it rather than kept in vHold().
  [ -n "$pHoldDir" ] && rm -rf -- "$pHoldDir" 2>/dev/null || :
  [ -n "$pidChainGroup" ] && kill -- -"$pidChainGroup" 2>/dev/null || :
  # The counting pair is not in the chain's group: bash gives a process
  # substitution the caller's group whatever job control says, so it has to
  # be taken by name, children first -- tee holds the hold's input open and
  # nothing downstream can end while it does.
  [ -n "$pidCounter" ] && {
    pkill -P "$pidCounter" 2>/dev/null
    kill "$pidCounter" 2>/dev/null
  } || :
}
trap 'vRelease
      exit 1' INT TERM HUP
trap vRelease EXIT

##
# @fn vHold()
# @brief Start the hold: a chain of dd, one per lane this side writes.
# @details Made, opened, and unlinked before anything is written to it:
#          the hold lives on its descriptors alone, so no name survives
#          for a bystander to read or a signal to strand, and there is
#          nothing to clean up. It leaves this shell holding the chain's
#          input on fd 5, to write, and its output on fd 3, to read.
# @global TMPDIR - read, where the hold's two fifos are made
# @global nPairs - read, how many copiers the chain has
# @global pHoldDir - set, the hold's directory, and empty once unlinked
# @global pidChainGroup - set, the chain, which leads its own group
# @return 0; a step that fails ends the script, under set -e
##
vHold() {
  pHoldDir=$(mktemp -d "${TMPDIR:-/tmp}/icc-frames-XXXXXXXX")
  mkfifo -m 600 "$pHoldDir/i" "$pHoldDir/o"
  # <> to start with, because it is the open that never blocks and there is
  # nobody at the other end yet.
  exec 3<> "$pHoldDir/o" 5<> "$pHoldDir/i"
  # The chain's own ends, and they are one-way on purpose: given a <> dup it
  # would be a writer on its own input and could never see EOF.
  exec 6< "$pHoldDir/i" 7> "$pHoldDir/o"
  # Now that each lane has somebody on the far side, take this script's ends
  # one-way too. A <> end is its own reader as well as its own writer, and
  # anything inheriting it can neither be refused nor see EOF: that is what
  # left a killed write's counting pair alive with nothing able to end it.
  exec 5>&-
  exec 5> "$pHoldDir/i"
  exec 3>&-
  exec 3< "$pHoldDir/o"
  rm -f "$pHoldDir/i" "$pHoldDir/o"
  rmdir "$pHoldDir"
  pHoldDir=
  # A group is a command with one stdin and one stdout, so the chain's ends
  # are the group's ends: the head reads the group's stdin, the tail writes
  # its stdout, and every stage between is a bare copier. The ends are put
  # on the group and closed in the same breath, so no stage inherits either
  # and every one of them holds nothing but 0, 1 and 2. A stage holding the
  # far end could never see EOF, which is what left fifteen copiers behind
  # the first time this was tried; now there is nothing for one to hold.
  # Neither 3 nor 5 goes either, for the same reason, and handing stdout to
  # the hold is what lets go of a caller's $( ).
  # What eval sees is one spelling of dd and a pipe: nothing a caller
  # controls is in it. Its own process group, so one signal reaches the
  # whole chain, and one lane a side needs no special case -- the group is
  # the same shape.
  local osChain iStage
  osChain="dd bs=4096 status=none"
  for (( iStage=1; iStage<nPairs; iStage++ )); do
    osChain="$osChain | dd bs=4096 status=none"
  done
  set -m
  eval "{ $osChain ; } <&6 >&7 6<&- 7>&- 3>&- 5>&- &"
  pidChainGroup=$!
  set +m
  exec 6<&- 7>&-
}

vHold
# The counting pair must not hold the hold's far end. Given fd 3 it is a
# reader on the output as well as a writer on the input, so it pins the ring
# from both sides: the chain's tail blocks instead of being refused, its head
# never sees EOF, and a write that dies without running its trap leaves the
# whole lot alive on descriptors nothing can name.
# Capped at what the hold can take. head -c reads exactly what it is asked
# for and leaves the rest where it was, so what is still on stdin after this
# is what would not have fitted.
exec 4< <(
  exec 3>&-
  head -c "$nHold" | tee "/dev/fd/5" | wc -c
)
pidCounter=$!
read -r nSize <&4
exec 4<&-
pidCounter=
# One byte more than the hold can take is a payload that never reaches a
# lane, so no read can free it and waiting cannot end it. Refused here,
# before the count goes out, so nothing of it is on the wire. Stdin says
# this whether it is a file or a pipe: the size was never the question, the
# byte after the last one it could hold is.
# Read the probe before testing it. An arithmetic test cannot say it does
# not know: given nothing it is a syntax error, and a syntax error here
# returns non-zero, which as the left arm of && is exempt from set -e and
# passes the payload. Every other fault in this script fails closed, and
# this is the only test in front of the hold, so what it cannot read it
# refuses rather than waves through.
nProbe=$(head -c 1 | wc -c)
[[ $nProbe =~ ^[0-9]+$ ]] || {
  echo "write: cannot tell whether the payload is past the hold" >&2
  exit 1
}
(( nProbe > 0 )) && {
  echo "write: the payload is past the hold: this bundle carries" \
    "$nHold, and more lanes is the only remedy" >&2
  exit 1
}
# Closing the last writer is what ends the chain: its head opened the hold
# read-only, so it sees EOF, drains what it has, and exits by itself.
exec 5>&-
# The count and the head of the payload go out as one write, so the count
# does not take a whole page of the first lane that a 4096-byte frame can
# never share. Frame 0 is short by the count's own length; every frame
# after it is PIPE_BUF, and the last is short as ever.
# head -c and not dd, and it is the same discipline either way: both write
# what their read returned and hold nothing of their own, which is why Pipes
# names dd and refuses cat. What dd cannot spell is an exact count. `count=`
# counts reads, so it stops at the first short one and leaves the rest of the
# frame behind, and the spelling that would not, iflag=fullblock, is the one
# Pipes says never to add.
nLeft=$nSize
nFirst=$(( nPipeBuf - ${#nSize} - 1 ))
(( nFirst > nLeft )) && nFirst=$nLeft
{
  printf '%s\n' "$nSize"
  (( nFirst > 0 )) && head -c "$nFirst" <&3
} 1<> "$pDir/$eSide"
nLeft=$(( nLeft - nFirst ))
iFrame=1
while (( nLeft > 0 )); do
  (( nWant = nLeft < nPipeBuf ? nLeft : nPipeBuf ))
  head -c "$nWant" <&3 1<> "$pDir/$(( (iFrame % nPairs) * 2 + eSide ))"
  nLeft=$(( nLeft - nWant ))
  iFrame=$(( iFrame + 1 ))
done
wait "$pidChainGroup" || {
  echo "write: the hold failed" >&2
  exit 1
}
pidChainGroup=
pidCounter=
