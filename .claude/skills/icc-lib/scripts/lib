#!/bin/bash
##
# @file lib
# @brief The functions ICC's pieces and harnesses share, written once.
# @details Sourced, not run. A script names its positional parameters,
#          sets -eu, and then sources this by fixed path, as the pieces
#          reach each other:
#              source "$(dirname "$0")/../../icc-lib/scripts/lib"
#          What is here is what more than one piece does, so they all do
#          it one way: counts checked, pipes checked, a seat's lanes read
#          off Patch's map and waited on without taking from them, cleanup
#          armed before anything is made, a piece's directory made and
#          printed at once, servers started deaf to a hangup, a lock named
#          for its path, a git wire's tip fetched, the harnesses' cut-off
#          and refusal checks, and the calibrations' ok and off.
#          Sourcing turns on extglob, which the lane glob needs when this
#          file is read.
#          A function that refuses says why on stderr and exits 1. Called
#          in $( ), that exit ends only the substitution, and bash does
#          not carry set -e into one: the caller assigns the result, and
#          the failed assignment stops it, and a function here that calls
#          another in $( ) says || exit 1 itself. osWho, when a script
#          sets it, goes in front of every refusal, as Frames' read and
#          write name themselves in all they say.
# @stdin nothing
# @stdout nothing
# @stderr nothing
# @exit 0
#
# Copyright (c) 2026 Brian Case. All rights reserved.
# AI contributor: Claude (Anthropic)
#
# MIT Licence. See LICENCE.TXT
##
shopt -s extglob

##
# @fn nCount()
# @brief Print a count given as digits, in base ten, or refuse it.
# @details Digits only, and no more than 18 significant ones, which 64
#          bits always hold: bash wraps a longer run without a word, and
#          a ring of 18446744073709551618 seats was a ring of 2. Then base
#          ten, because $(( )) reads a leading zero as octal and [ does
#          not, and two readings of one count is how an odd one got past.
#          What else the count must be, even or more than zero, is the
#          caller's to say.
# @param $1 osWhat - what the count is of, for the refusal: lanes, seats
# @param $2 osValue - the count as given
# @stdout the count, in base ten
# @stderr the reason, on refusal
# @global osWho - read, what goes in front of a refusal, when set
# @return 0; it exits 1 instead when the count is refused
##
nCount() {
  local osWhat=$1
  local osValue=$2
  case $osValue in
    ''|*[!0-9]*)
      echo "${osWho:+$osWho: }$osWhat must be a whole number: $osValue" >&2
      exit 1
      ;;
  esac
  [[ $osValue =~ ^0*[0-9]{1,18}$ ]] || {
    echo "${osWho:+$osWho: }$osWhat too big: $osValue" >&2
    exit 1
  }
  echo $((10#$osValue))
}

##
# @fn nLanesGiven()
# @brief Print a lane count someone gave, in base ten, or refuse it.
# @details A count as nCount takes one, then even, then more than zero:
#          what Pipes' create asks of N, in its words. Patch's create asks
#          the same of LANES, so a shape that makes no pipe still refuses
#          what Pipes would.
# @param $1 osValue - the count as given
# @stdout the count, in base ten
# @stderr the reason, on refusal
# @global osWho - read, as nCount reads it
# @return 0; it exits 1 instead when the count is refused
##
nLanesGiven() {
  local osValue=$1
  local nLanes
  nLanes=$(nCount lanes "$osValue") || exit 1
  case $nLanes in
    *[13579])
      echo "${osWho:+$osWho: }lanes must be even: $osValue" >&2
      exit 1
      ;;
  esac
  [ "$nLanes" -gt 0 ] || {
    echo "${osWho:+$osWho: }lanes must be more than zero" >&2
    exit 1
  }
  echo "$nLanes"
}

##
# @fn vSide()
# @brief Refuse a SIDE that is not 0 or 1.
# @details Called before SIDE is used anywhere: it ends up in arithmetic,
#          where a subscript is evaluated, so anything but 0 or 1 is
#          refused rather than worked out.
# @param $1 eSide - the side as given
# @stderr the reason, on refusal
# @global osWho - read, as nCount reads it
# @return 0; it exits 1 instead when SIDE is refused
##
vSide() {
  local eSide=$1
  case $eSide in
    0|1)
      ;;
    *)
      echo "${osWho:+$osWho: }SIDE is 0 or 1, not $eSide" >&2
      exit 1
      ;;
  esac
}

##
# @fn nLanesOf()
# @brief Print the lane count the pipes given share, or refuse them.
# @details Lane 0 of every pipe first, so a path that is no pipe at all
#          says so. Then the first pipe's count: its names of digits and
#          nothing else, from a glob, never from ls, whose output is for
#          people to read. Lane 0 is there, so the glob matches at least
#          that. Then that count even, in Pipes' words, which with lane 0
#          there is two or more, so either SIDE has a lane. Then every
#          pipe the same count, and every lane of each a fifo: a numeric
#          entry that is not a lane would count toward the count and then
#          be written to or read as a file.
# @param $1 pFirst - the pipe whose count the others must match
# @param $2... - the other pipes
# @stdout the lane count
# @stderr the reason, on refusal, naming the pipe as the caller spelled it
# @global osWho - read, as nCount reads it
# @return 0; it exits 1 instead when a pipe is refused
##
nLanesOf() {
  local pFirst=$1
  local pPipe
  local aLanes
  local nLanes
  local iLane
  for pPipe; do
    [ -p "$pPipe/0" ] || {
      echo "${osWho:+$osWho: }not a pipe: $pPipe" >&2
      exit 1
    }
  done
  aLanes=("$pFirst"/+([0-9]))
  nLanes=${#aLanes[@]}
  case $nLanes in
    *[13579])
      echo "${osWho:+$osWho: }lanes must be even: $pFirst" >&2
      exit 1
      ;;
  esac
  for pPipe; do
    aLanes=("$pPipe"/+([0-9]))
    [ "${#aLanes[@]}" -eq "$nLanes" ] || {
      echo "${osWho:+$osWho: }lanes differ: $pPipe" >&2
      exit 1
    }
    iLane=0
    while [ "$iLane" -lt "$nLanes" ]; do
      [ -p "$pPipe/$iLane" ] || {
        echo "${osWho:+$osWho: }not a pipe: $pPipe" >&2
        exit 1
      }
      iLane=$((iLane + 1))
    done
  done
  echo "$nLanes"
}

##
# @fn oLanes()
# @brief Print the lanes a seat writes, or the lanes it reads, off
#        Patch's map.
# @details A pipe two seats share is on two lines of the map, and there
#          the seat writes its own side's lanes and reads the other's. A
#          pipe through a fitting is on one, and goes one way: side 0
#          writes side 0's lanes, and side 1 reads them. Which lanes a side
#          writes is Pipes': side 0 the even ones and side 1 the odd, of
#          the LANES on the map's first line. The seat is matched as a
#          string, handed to awk through the environment, where no escape
#          in it is read, so no spelling of a seat but the map's finds a
#          lane; and "-", the map's nobody, is no seat. A seat the map
#          does not name gets nothing either way, and p on a mesh-p gets
#          nothing to write; telling the two apart is the caller's.
# @param $1 pPatch - the patch, as Patch's create printed it
# @param $2 osSeat - the seat, as the map spells it
# @param $3 eWay - w for the lanes it writes, r for those it reads
# @stdout for w, one "LANE" per lane; for r, one "LANE PEERS" per lane,
#         PEERS the seats that write into it, comma separated; each LANE
#         a path, in the map's order, or nothing
# @stderr awk's, when the map cannot be read
# @return awk's status: 0 unless the map could not be read
##
oLanes() {
  local pPatch=$1
  local osSeat=$2
  local eWay=$3
  SEAT=$osSeat awk -v k="$eWay" '
    NR == 1 {
      nLanes = $3
      next
    }
    {
      n[$3]++
      a[NR] = $0
    }
    END {
      for (i = 2; i <= NR; i++) {
        split(a[i], f, " ")
        if (f[1] == "-" || f[1] "" != ENVIRON["SEAT"] "")
          continue
        b = n[f[3]] == 2
        if (k == "w" && (f[2] == 0 || b))
          for (j = f[2]; j < nLanes; j += 2)
            print f[3] "/" j
        if (k == "r" && (f[2] == 1 || b))
          for (j = 1 - f[2]; j < nLanes; j += 2)
            print f[3] "/" j, f[4]
      }
    }' "$pPatch/patch"
}

##
# @fn vWaitFor()
# @brief Wait until every lane a seat reads has something on it, taking
#        nothing, or say not yet.
# @details Called, not captured, by what reads a seat's lanes, before it
#          takes anything: a reader cut off while it waits has taken nothing and
#          can be called again, where one cut off partway through its
#          reading has lost what it took. read -t 0 looks at a lane without
#          taking from it, as Merge's copier does. The lane is opened to
#          read and write, which on a fifo waits for nothing: a lane whose
#          holder is gone is looked at and found empty, where opened only
#          to read it would hang the look, deadline and all. Before every
#          look it checks the lane is still a fifo and refuses it at once
#          if not, so a lane taken away while it waits is refused then,
#          and never opened: opened to read and write, a path that is gone
#          would be made. It gives up after the seconds its caller gives
#          it, looking about once a second, and 0 looks once. How long
#          that should be, the caller knows and this does not.
# @param $1 pPatch - the patch, as Patch's create printed it
# @param $2 osSeat - the seat, as the map spells it
# @param $3 nSeconds - how long to wait, a count as nCount takes one
# @stderr "not yet, nothing taken" when the time runs out first; "not a
#         lane" and the path, for one that is not a fifo or no longer is;
#         nCount's reason, for seconds that are not a count; awk's, when
#         the map cannot be read
# @global osWho - read, as nCount reads it
# @return 0 every lane has something on it, or the seat reads none; it
#         exits 1 instead when the time runs out first, a lane is not a
#         fifo, the seconds are refused, or the map cannot be read
##
vWaitFor() {
  local pPatch=$1
  local osSeat=$2
  local nSeconds
  local nEnd
  local pLane
  local osLanes
  nSeconds=$(nCount seconds "${3-}") || exit 1
  osLanes=$(oLanes "$pPatch" "$osSeat" r) || exit 1
  [ -n "$osLanes" ] || return 0
  nEnd=$((SECONDS + nSeconds))
  while read -r pLane _; do
    while :; do
      [ -p "$pLane" ] || {
        echo "${osWho:+$osWho: }not a lane: $pLane" >&2
        exit 1
      }
      if read -t 0 <> "$pLane"; then
        break
      fi
      [ "$SECONDS" -lt "$nEnd" ] || {
        echo "${osWho:+$osWho: }not yet, nothing taken" >&2
        exit 1
      }
      sleep 1
    done
  done <<< "$osLanes"
}

##
# @fn vArm()
# @brief Arm a cleanup before anything is made, and have a signal run it.
# @details The one way every piece and every harness arms its cleanup.
#          Each name the cleanup reads starts empty, this is called, and
#          only then is anything made: bash runs a caught signal only once
#          the $( ) that makes a thing, and its assignment, are done, so
#          the cleanup always knows what there is to take. A signal exits
#          1, which runs it. Called again, it arms a new cleanup in place
#          of the old.
# @param $1 osCleanup - the cleanup, as trap takes it
# @return 0
##
vArm() {
  local osCleanup=$1
  trap "$osCleanup" EXIT
  vStopOnSignal
}

##
# @fn vStopOnSignal()
# @brief Have INT, TERM and HUP exit 1, which runs the EXIT trap.
# @details vArm's second half, and what a handler that swapped the signal
#          traps for a while puts back.
# @return 0
##
vStopOnSignal() {
  trap 'exit 1' INT TERM HUP
}

##
# @fn vDisarm()
# @brief Clear the cleanup and the signal traps: what was made is whole.
# @return 0
##
vDisarm() {
  trap - EXIT INT TERM HUP
}

##
# @fn pMakeDir()
# @brief Make a piece's directory under /tmp, and print it at once.
# @details Called, not captured: it sets pDir and prints it on the caller's
#          stdout the moment it is made, before anything goes in it. So a
#          caller that is cut off or fails after has already said what it
#          made, and whoever ran it looks for that and nothing else; and a
#          print that fails, fails while the cleanup is armed, which takes
#          the directory. A mktemp that fails made nothing and prints
#          nothing, and under set -e it ends the caller. Arm the cleanup
#          first, as vArm says: the signal waits for the assignment, so
#          the cleanup always knows pDir.
# @param $1 osKind - what the directory is named for: icc-pipes, icc-tee
# @stdout the directory, one line
# @global pDir - set, the directory made
# @return 0; under set -e a mktemp or a print that fails ends the caller
##
pMakeDir() {
  local osKind=$1
  pDir=$(mktemp -d "/tmp/$osKind-XXXXXXXX")
  echo "$pDir"
}

##
# @fn vServe()
# @brief Make this subshell a server: none of the traps, deaf to HUP.
# @details The first thing a hold or a copier does, before it execs. It is
#          its maker's child until then, so it has its maker's traps: one
#          killed from the handler ran the handler again, in it, racing
#          the shell that sent the signal. And it is a server: it serves
#          whoever holds the pipes' ends long after its maker, and whoever
#          ran that, are gone, so a hangup is not its business. It ignores
#          HUP, as a server run under nohup does, and exec keeps it
#          ignored; TERM, which remove sends, still ends it.
# @return 0
##
vServe() {
  trap - EXIT INT TERM
  trap '' HUP
}

##
# @fn vLockOf()
# @brief Name the lock on a path: the path, and the lock's directory.
# @details Called, not captured, by icc-lock's create and remove, so the
#          two name every lock one way and refuse the same paths. The path
#          is as readlink -m spells it, so every spelling of one path is
#          one lock, and it need not be there. A newline is refused, before
#          and after: $( ) drops a trailing one, which would name some other
#          path's lock.
# @param $1 osPath - the path as given
# @stderr the reason, on refusal
# @global osWho - read, as nCount reads it
# @global pPath - set, the path as readlink -m spells it
# @global pLock - set, /tmp/icc-lock-KEY, KEY the sha256 of pPath
# @return 0; it exits 1 instead when the path is refused
##
vLockOf() {
  local osPath=$1
  local osKey
  pPath=$(readlink -m -- "$osPath") || exit 1
  case $osPath/$pPath in
    *$'\n'*)
      echo "${osWho:+$osWho: }PATH has a newline in it" >&2
      exit 1
      ;;
  esac
  osKey=$(printf '%s' "$pPath" | sha256sum) || exit 1
  pLock=/tmp/icc-lock-${osKey%% *}
}

##
# @fn vWireTip()
# @brief Fetch a git wire's tip into a scratch repo, or find the wire is
#        not there yet.
# @details Called, not captured, by icc-git's send, read and list, so the
#          three reach a wire one way and refuse the same REFs. The first
#          call makes the scratch repo: git's variables that would point it
#          at some other repo are cleared, so the caller's own repo is
#          neither read nor written, and a bare repo is made under /tmp and
#          set in pWork. Arm the cleanup first, as vArm says. REF is a
#          branch name, as git check-ref-format --branch takes one in a
#          repo with no history, so @{-1} and the like are refused. Only
#          the tip is fetched, --depth=1: a send builds on it, and a read
#          needs nothing older. A fetch that fails is put to ls-remote: its
#          exit 2 is a branch not on REMOTE, which no send has made yet.
#          Its exit 0 is a branch made between the two, by a send racing
#          this one, and it is fetched once more: a branch is made once, so
#          a second fetch that fails is a fault. Anything else is a REMOTE
#          not read. A fault is said in fetch's own words. Both run in the
#          scratch repo, so a remote's name from the caller's own repo is
#          not one. Called again, it fetches the tip as it is now.
# @param $1 osRemote - the remote, as git fetch takes one: a URL or a path
# @param $2 osRef - the branch the wire is on
# @stderr the reason, on refusal
# @global osWho - read, as nCount reads it
# @global pWork - read and set: the scratch repo, made when it is empty
# @global osTip - set, the tip's commit; empty when REF is not on REMOTE
# @return 0; it exits 1 instead when REF is refused or REMOTE is not read
##
vWireTip() {
  local osRemote=$1
  local osRef=$2
  local osSaid
  local nStatus
  local iFetch
  if [ -z "$pWork" ]; then
    unset GIT_DIR GIT_WORK_TREE GIT_IMPLICIT_WORK_TREE GIT_COMMON_DIR \
      GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_INDEX_FILE \
      GIT_SHALLOW_FILE GIT_GRAFT_FILE GIT_NO_REPLACE_OBJECTS \
      GIT_REPLACE_REF_BASE GIT_PREFIX
    pWork=$(mktemp -d /tmp/icc-git-XXXXXXXX) || exit 1
    git init -q --bare "$pWork" || exit 1
  fi
  if ! git --git-dir="$pWork" check-ref-format --branch "$osRef" \
      > /dev/null 2>&1; then
    echo "${osWho:+$osWho: }REF is not a branch name: $osRef" >&2
    exit 1
  fi
  osTip=
  for iFetch in 1 2; do
    if osSaid=$(git --git-dir="$pWork" fetch -q --depth=1 -- \
        "$osRemote" "refs/heads/$osRef" 2>&1); then
      osTip=$(git --git-dir="$pWork" rev-parse FETCH_HEAD) || exit 1
      return 0
    fi
    nStatus=0
    git --git-dir="$pWork" ls-remote --exit-code -- \
      "$osRemote" "refs/heads/$osRef" > /dev/null 2>&1 || nStatus=$?
    [ "$nStatus" -ne 2 ] || return 0
    [ "$nStatus" -eq 0 ] || break
  done
  echo "${osWho:+$osWho: }$osSaid" >&2
  exit 1
}

##
# @fn vCutOffAt()
# @brief For the harnesses: cut a command off while it waits in one it
#        runs, and check it goes and takes what it made with it.
# @details A stand-in for osStub, first on PATH, waits in its place, so the
#          signal lands while the command is partway through. The stand-in
#          takes itself away first, so any later call is the real one. What
#          the command made is what it printed first, as pMakeDir prints a
#          directory the moment it is made; or, standing in for mktemp,
#          what the stand-in made: it makes what the real one would and
#          prints it before it waits, so the signal lands once the thing
#          exists and before the command has its name, the moment a
#          cleanup armed after mktemp misses.
# @param $1 osSignal - the signal to send, as kill takes it: TERM, HUP
# @param $2 osStub - the command to stand in for: mktemp, tr, mkfifo
# @param $3... aCommand - the command and its arguments
# @stderr "cut off, not taken" and the command, when it failed
# @return 0 the command exited 1, had made something, and it is gone; it
#         exits 1 instead when not
##
vCutOffAt() {
  local osSignal=$1
  local osStub=$2
  shift 2
  local aCommand=("$@")
  local pBin
  local osMake=
  local pidCommand
  local pidStub
  local pMade
  local nStatus=0
  pBin=$(mktemp -d)
  [ "$osStub" != mktemp ] ||
    osMake='pMade=$(command -p mktemp "$@"); echo "$pMade"'
  printf '%s\n' '#!/bin/bash' 'rm -- "$0"' 'pMade=' "$osMake" \
    'echo "$$ $pMade" > "${0%/*}/stalled"' 'exec sleep 30' > "$pBin/$osStub"
  chmod +x "$pBin/$osStub"
  PATH=$pBin:$PATH "${aCommand[@]}" > "$pBin/printed" 2>/dev/null &
  pidCommand=$!
  while [ ! -s "$pBin/stalled" ]; do
    kill -0 "$pidCommand" 2>/dev/null || break
  done
  read -r pidStub pMade < "$pBin/stalled"
  kill "-$osSignal" "$pidCommand"
  kill "$pidStub"
  wait "$pidCommand" || nStatus=$?
  [ -n "$pMade" ] || read -r pMade < "$pBin/printed" || :
  rm -rf "$pBin"
  [ "$nStatus" -eq 1 ] && [ -n "$pMade" ] && [ ! -e "$pMade" ] || {
    echo "cut off, not taken: ${aCommand[*]}" >&2
    [ -z "$pMade" ] || rm -rf "$pMade"
    exit 1
  }
}

##
# @fn vCutOff()
# @brief For the harnesses: cut a command off just after its first
#        mktemp, and check it goes and takes what that made with it.
# @details vCutOffAt, with TERM, standing in for mktemp.
# @param $1... aCommand - the command and its arguments
# @stderr "cut off, not taken" and the command, when it failed
# @return 0 the command exited 1 and what its mktemp made is gone; it exits
#         1 instead when not
##
vCutOff() {
  vCutOffAt TERM mktemp "$@"
}

##
# @fn vRefused()
# @brief For the harnesses: run a command that must be refused, and stop
#        if it is not.
# @details set -e is ignored for a pipeline that begins with !, so `! cmd`
#          states a refusal without ever being able to fail the harness.
#          vRefused runs the command and stops if it succeeds.
# @param $1... aCommand - the command and its arguments
# @stderr "not refused" and the command, when it was not; the command's
#         own stderr goes nowhere
# @return 0 the command was refused; it exits 1 instead when it was not
##
vRefused() {
  local aCommand=("$@")
  if "${aCommand[@]}" 2>/dev/null; then
    echo "not refused: ${aCommand[*]}" >&2
    exit 1
  fi
}

##
# @fn vFound()
# @brief For the calibrations: print what a case found, marked as what a
#        SKILL.md says or not.
# @details One line, ok or off in front, so a record read years later says
#          at a glance which cases came out as written then. The
#          calibration counts the off ones, and once every case has run
#          exits 1 if there are any.
# @param $1 bAsSaid - 1 when what was found is what the SKILL.md says, 0
#        when not
# @param $2... aFound - what was found, joined with a space into one line
# @stdout "ok   " or "off  ", then what was found
# @global nOff - read and set: one more for each off
# @return 0
##
vFound() {
  local bAsSaid=$1
  shift
  local osFound="$*"
  if [ "$bAsSaid" -eq 1 ]; then
    echo "ok   $osFound"
  else
    echo "off  $osFound"
    nOff=$((nOff + 1))
  fi
}
