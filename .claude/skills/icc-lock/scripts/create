#!/bin/bash
##
# @file create
# @brief Take the lock on PATH, or say it is held.
# @details create PATH. The lock is a directory, /tmp/icc-lock-KEY, KEY the
#          sha256 of PATH as readlink -m spells it, so every spelling of one
#          path is one lock. mkdir(1) makes it or fails, and does either at
#          once: of any number of creates for one path at once, one makes
#          it and the rest are told it is held. PATH need not be there; a
#          newline in it is refused. The directory holds one file, lock,
#          naming PATH. The lock is held until remove gives it back: nothing
#          else ends it, and nothing runs to hold it.
# @stdin nothing
# @stdout the lock's directory, one line, the moment it is made
# @stderr the reason, on refusal; "held: PATH" when the lock was taken
#         already
# @exit 0 PATH is locked; 1 PATH is refused, or the lock could not be
#       finished and none of it is left; 2 PATH was locked already, and
#       nothing was made
#
# Copyright (c) 2026 Brian Case. All rights reserved.
# AI contributor: Claude (Anthropic)
#
# MIT Licence. See LICENCE.TXT
##
osPath=${1:?usage: create PATH}
set -eu
source "$(dirname "$0")/../../icc-lib/scripts/lib"
# One path has many spellings, so every spelling is made the one readlink -m
# makes before the lock is named for it. A newline is refused, before and
# after: $( ) drops a trailing one, which would lock some other path, and the
# lock keeps PATH as a line.
pPath=$(readlink -m -- "$osPath")
case $osPath/$pPath in
  *$'\n'*)
    echo "PATH has a newline in it" >&2
    exit 1
    ;;
esac
osKey=$(printf '%s' "$pPath" | sha256sum)
pLock=/tmp/icc-lock-${osKey%% *}
# Until the lock names its path it is not finished: a create that cannot
# finish takes the directory with it. Armed before anything is made, as
# icc-lib's vArm says, and the directory is made inside the $( ) whose
# assignment a signal waits for, so the cleanup knows it once it is there.
pDir=
vArm 'if [ -n "$pDir" ]; then
        rm -f "$pDir/lock"
        rmdir "$pDir" 2>/dev/null || :
      fi
      exit 1'
pDir=$(mkdir -- "$pLock" 2>/dev/null && echo "$pLock") || {
  vDisarm
  [ -d "$pLock" ] || {
    echo "cannot lock: $pPath" >&2
    exit 1
  }
  echo "held: $pPath" >&2
  exit 2
}
echo "$pDir"
printf '%s\n' "$pPath" > "$pDir/lock"
vDisarm
