#!/bin/bash
##
# @file list
# @brief One line per hold: its directory, up or down, and the path held.
# @details list takes nothing. A hold is a /tmp/icc-lock-* directory with
#          a lock file in it naming PATH and then a file under
#          /tmp/icc-lock/; anything else is skipped. eState is up or down:
#          up when the hold named in the pid file still has that file open
#          on fd 3, which is where create left it, and so still holds the
#          lock; down otherwise, for a missing pid file, a lease run out, a
#          hold killed, or a pid since recycled to a stranger.
# @stdin nothing
# @stdout "DIR up PATH" or "DIR down PATH", one line per hold, in glob
#         order
# @stderr nothing
# @exit 0, with holds or without
#
# Copyright (c) 2026 Brian Case. All rights reserved.
# AI contributor: Claude (Anthropic)
#
# MIT Licence. See LICENCE.TXT
##
for pDir in /tmp/icc-lock-*/; do
  [ -d "$pDir" ] || continue
  pDir=${pDir%/}
  # Read once, and quietly: a hold can go while this runs, which is not this
  # script's to report, so one gone is skipped like one never made.
  mapfile -t aRecord 2>/dev/null < "$pDir/lock" || continue
  # A record that names no locked file was not written by create, and an
  # empty one read against a missing pid would read as up.
  case ${aRecord[1]-} in
    /tmp/icc-lock/?*)
      ;;
    *)
      continue
      ;;
  esac
  pidHold=$(cat "$pDir/pid" 2>/dev/null)
  eState=down
  [ "$(readlink "/proc/$pidHold/fd/3" 2>/dev/null)" = "${aRecord[1]}" ] &&
    eState=up
  echo "$pDir $eState ${aRecord[0]}"
done
