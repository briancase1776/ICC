#!/bin/bash
##
# @file list
# @brief One line per lock: its directory, and the path it locks.
# @details list takes nothing. A lock is a /tmp/icc-lock-KEY directory, KEY
#          sixty-four hex digits; anything else is skipped. PATH is read
#          from its lock file, and is - when there is none: a create that
#          has not finished yet, or one killed outright before it could say.
# @stdin nothing
# @stdout "DIR PATH", one line per lock, in glob order
# @stderr nothing
# @exit 0, with locks or without
#
# Copyright (c) 2026 Brian Case. All rights reserved.
# AI contributor: Claude (Anthropic)
#
# MIT Licence. See LICENCE.TXT
##
for pDir in /tmp/icc-lock-*/; do
  [ -d "$pDir" ] || continue
  pDir=${pDir%/}
  [[ ${pDir#/tmp/icc-lock-} =~ ^[0-9a-f]{64}$ ]] || continue
  # Read quietly: a lock can be given back while this runs. stderr is
  # silenced before the file is opened, or the open's own error still prints.
  read -r pPath 2>/dev/null < "$pDir/lock" || pPath=
  echo "$pDir ${pPath:--}"
done
