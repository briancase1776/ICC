#!/bin/bash
##
# @file list
# @brief One line per lock: its directory.
# @details list takes nothing. A lock is a /tmp/icc-lock-KEY directory, KEY
#          sixty-four hex digits, the sha256 of the path it locks; anything
#          else is skipped. Which path that is, is not written down.
# @stdin nothing
# @stdout the lock's directory, one line per lock, in glob order
# @stderr nothing
# @exit 0, with locks or without
#
# Copyright (c) 2026 Brian Case. All rights reserved.
# AI contributor: Claude (Anthropic)
#
# MIT Licence. See LICENCE.TXT
##
for pDir in /tmp/icc-lock-*/; do
  [ -d "$pDir" ] || continue
  pDir=${pDir%/}
  [[ ${pDir#/tmp/icc-lock-} =~ ^[0-9a-f]{64}$ ]] || continue
  echo "$pDir"
done
