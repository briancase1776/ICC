#!/bin/bash
##
# @file remove
# @brief Give the lock on PATH back.
# @details remove PATH. PATH is spelled any way that resolves to the path
#          create was given. Whoever took the lock, remove gives it back:
#          the lock is advisory, and one whose holder has gone is given back
#          this way. Only what create made is taken, the lock file and then
#          the directory, which rmdir leaves in place if anything else is in
#          it.
# @stdin nothing
# @stdout nothing
# @stderr the reason, on refusal
# @exit 0 the lock is given back; 1 PATH was not locked, or its directory
#       held something create did not make and was left in place
#
# Copyright (c) 2026 Brian Case. All rights reserved.
# AI contributor: Claude (Anthropic)
#
# MIT Licence. See LICENCE.TXT
##
osPath=${1:?usage: remove PATH}
set -eu
# Named as create names it.
pPath=$(readlink -m -- "$osPath")
osKey=$(printf '%s' "$pPath" | sha256sum)
pLock=/tmp/icc-lock-${osKey%% *}
[ -d "$pLock" ] || {
  echo "not locked: $pPath" >&2
  exit 1
}
rm -f "$pLock/lock"
rmdir "$pLock" || {
  echo "not a lock, left in place: $pLock" >&2
  exit 1
}
