#!/bin/bash
##
# @file remove
# @brief Give the lock on PATH back.
# @details remove PATH. PATH is named as create names it, by icc-lib's
#          vLockOf, so any spelling create would take gives back the same
#          lock, and one create refuses, remove refuses too. rmdir(1) takes
#          the lock away, whoever took it: the lock is advisory, and one
#          whose holder has gone is given back this way. rmdir refuses a
#          directory with anything in it, which create did not make.
# @stdin nothing
# @stdout nothing
# @stderr the reason, on refusal: rmdir's own when the lock is not taken
#         away
# @exit 0 the lock is given back; 1 it is not: PATH is refused, or was not
#       locked, or its directory holds something
#
# Copyright (c) 2026 Brian Case. All rights reserved.
# AI contributor: Claude (Anthropic)
#
# MIT Licence. See LICENCE.TXT
##
osPath=${1:?usage: remove PATH}
set -eu
source "$(dirname "$0")/../../icc-lib/scripts/lib"
vLockOf "$osPath"
rmdir -- "$pLock"
