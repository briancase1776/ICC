#!/bin/bash
##
# @file create
# @brief Copy what SIDE writes into every SRC onto DST, and print the merge.
# @details create DST SIDE SRC... DST and every SRC are pipes Pipes made,
#          every lane of them a fifo, all with the same even lane count.
#          SIDE is 0 or 1, the side whose writes are copied. No SRC is DST
#          and none is given twice, in any spelling. For each lane SIDE
#          writes, of each SRC, a copier, dd(1) at bs=4096, takes that
#          lane of that SRC and writes it to that lane of DST, byte for
#          byte, in order per inlet, until removed; a copier ignores a
#          hangup, as a server does. create opens each lane of DST itself,
#          so a DST whose hold is dead blocks create, where the caller's
#          bound reaches it. The merge's directory holds two files: merge,
#          naming DST, SIDE and each SRC a line, and pid, one copier a
#          line in lane order, SRC order within a lane. The merge makes
#          nothing but itself.
#          A create that cannot finish takes its copiers and its
#          directory with it. Once the merge is whole that is no longer
#          armed, so a create that then fails to print leaves a whole
#          merge nobody was told of, which list shows and remove takes.
# @stdin nothing
# @stdout the merge's directory, one line
# @stderr the reason, on refusal
# @exit 0 the merge is made and printed; 1 the arguments are refused,
#       or the merge could not be finished or was removed while it
#       started, and none of it is left, or it could not be printed and
#       all of it is
#
# Copyright (c) 2026 Brian Case. All rights reserved.
# AI contributor: Claude (Anthropic)
#
# MIT Licence. See LICENCE.TXT
##
pDst=$1
eSide=$2
set -eu
source "$(dirname "$0")/../../icc-lib/scripts/lib"
[ $# -ge 3 ] || {
  echo "usage: create DST SIDE SRC..." >&2
  exit 1
}
shift 2
vSide "$eSide"
# DST and every SRC are checked as icc-lib's nLanesOf checks them, which is
# how Tee's create and Frames' read and write check theirs. A numeric entry
# that is not a lane would count toward the count and then kill its copier
# on open, where nothing can say so: a copier's stderr goes nowhere and list
# only ever says down.
nLanes=$(nLanesOf "$pDst" "$@")
# One pipe, one spelling. The checks below, the merge file and the copiers'
# argv all get the canonical path, so the path list prints is the path that
# finds the copiers.
pDst=$(readlink -f -- "$pDst")
aSrcs=()
for pPipe; do
  pSrc=$(readlink -f -- "$pPipe")
  # A SRC that is DST copies a lane back into itself. The same SRC twice is
  # two copiers on one inlet lane, two readers of it, and the order it went
  # in on that inlet is the one thing a merge promises. Checked as Tee's
  # create checks its DSTs, and said in the caller's spelling.
  [ "$pSrc" != "$pDst" ] || {
    echo "SRC is DST: $pPipe" >&2
    exit 1
  }
  for pSeen in "${aSrcs[@]}"; do
    [ "$pSrc" != "$pSeen" ] || {
      echo "SRC twice: $pPipe" >&2
      exit 1
    }
  done
  aSrcs+=("$pSrc")
done
# Until the merge is whole it is not a merge: a create that cannot finish
# takes its copiers and its directory with it, and exits 1. Armed before
# anything is made, as icc-lib's vArm says. aPids stays empty until there is
# a copier, as in Tee's create. The copiers are killed from this list and
# not from the pid file, because the file can be gone by then -- a remove can
# take this directory while the open below is still waiting, and a copier
# forked after that would answer to nothing.
pDir=
aPids=()
vArm '[ ${#aPids[@]} -eq 0 ] || kill "${aPids[@]}" 2>/dev/null || :
      [ -n "$pDir" ] && rm -rf "$pDir" || :
      exit 1'
pDir=$(mktemp -d /tmp/icc-merge-XXXXXXXX)
{
  printf '%s\n' "$pDst" "$eSide"
  printf '%s\n' "${aSrcs[@]}"
} > "$pDir/merge"
# Both files from here on, so a merge is the same shape to list and to remove
# before the first copier is forked as after. The open below can wait forever.
: > "$pDir/pid"
iLane=$eSide
while [ "$iLane" -lt "$nLanes" ]; do
  # Open the outlet lane here, where a wait or a failure is this shell's own
  # and the caller's bound reaches it. Opened in the copier instead, an
  # outlet whose hold is dead blocks a forked shell that still holds this
  # one's stdout, and $(create) never returns though create has.
  exec 3> "$pDst/$iLane"
  for pSrc in "${aSrcs[@]}"; do
    # The copier inherits the open lane as its stdout and never opens it, and
    # fd 3 is closed because it has that lane already. It is dd at bs=4096,
    # which is PIPE_BUF, so each chunk it writes lands whole against the other
    # inlets' copiers on this lane; Pipes says why it is not cat. Its stderr
    # goes nowhere -- the outlet carries what the inlets wrote, and a
    # diagnostic on it would be bytes no inlet ever wrote -- so dd's summary
    # needs no status=none. dd opens if= onto its stdin, which is /dev/null
    # until it has, and that fd is what list and remove know a copier by.
    # It is a server, started as icc-lib's vServe says.
    (
      vServe
      exec >&3 2>/dev/null 3>&-
      exec dd if="$pSrc/$iLane" bs=4096 < /dev/null
    ) &
    aPids+=($!)
    echo $! >> "$pDir/pid"
  done
  exec 3>&-
  iLane=$((iLane + 2))
done
# Still ours? A remove that ran while an open above waited took the directory,
# and these copiers are now merging into a merge that no longer exists, which
# nothing can list and nothing can stop. They are this shell's to end.
[ -d "$pDir" ] && [ -f "$pDir/merge" ] && [ -f "$pDir/pid" ] || {
  echo "removed while starting: $pDir" >&2
  exit 1
}
vDisarm
echo "$pDir"
