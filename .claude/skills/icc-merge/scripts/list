#!/bin/bash
##
# @file list
# @brief One line per merge: its directory, up or down, and its merge file.
# @details list takes nothing. A merge is a /tmp/icc-merge-* directory
#          with a merge file naming a SIDE of 0 or 1 and at least one
#          SRC; anything else is skipped. eState is up or down: up when
#          the pid file names at least one copier and every one of them
#          still has its own inlet lane open on fd 0, and down otherwise.
#          A copier's inlet lane is read off its place in the pid file:
#          SRC order within a lane, and lanes from SIDE in steps of two.
#          eSide is that SIDE, 0 or 1, as the merge file's second line
#          has it.
# @stdin nothing
# @stdout "DIR up|down DST SIDE SRC...", one line per merge, in glob order
# @stderr nothing
# @exit 0, with merges or without
#
# Copyright (c) 2026 Brian Case. All rights reserved.
# AI contributor: Claude (Anthropic)
#
# MIT Licence. See LICENCE.TXT
##
for pDir in /tmp/icc-merge-*/; do
  pDir=${pDir%/}
  # A directory of the right name is not a merge. An unfinished create and a
  # stray mkdir both look like one from here, and neither is. The file is
  # read once, and quietly: a merge can go while this runs, which is not this
  # script's to report, so one gone is skipped like one never made. stderr
  # is silenced before the file is opened, or the open's own error prints.
  mapfile -t aRecord 2>/dev/null < "$pDir/merge" || continue
  eSide=${aRecord[1]}
  # Nor is one whose SIDE is not 0 or 1. It goes into arithmetic below, where
  # it stopped the listing, or ran what a subscript in it spelled.
  case $eSide in
    0|1)
      ;;
    *)
      continue
      ;;
  esac
  aSrcs=("${aRecord[@]:2}")
  # A merge file with no SRC line is not one either, and saying so by dividing
  # by zero would take the whole listing with it: the glob is sorted, so one
  # such directory named early hides every merge after it from every caller.
  [ "${#aSrcs[@]}" -ge 1 ] || continue
  nSrcs=${#aSrcs[@]}
  # Down until every copier answers, the way Pipes reads a hold: a merge with
  # no copiers yet, or none left, is not up, and only a positive check says
  # otherwise. The mark is the inlet lane on fd 0, where dd puts if=,
  # canonically spelled; the outlet lane would not do, since two merges onto
  # one outlet share it.
  eState=down
  iCopier=0
  nUp=0
  for pidCopier in $(cat "$pDir/pid" 2>/dev/null); do
    [ "$(readlink "/proc/$pidCopier/fd/0" 2>/dev/null)" = \
      "${aSrcs[iCopier % nSrcs]}/$((eSide + 2 * (iCopier / nSrcs)))" ] &&
      nUp=$((nUp + 1))
    iCopier=$((iCopier + 1))
  done
  [ "$iCopier" -gt 0 ] && [ "$nUp" -eq "$iCopier" ] && eState=up
  echo "$pDir $eState ${aRecord[*]}"
done
