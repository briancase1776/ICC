#!/bin/bash
##
# @file create
# @brief Patch pipes, tees and merges into SHAPE over N seats; print it.
# @details create SHAPE N [LANES [DEPTH]]. SHAPE is star, ring, mesh,
#          ring-p or mesh-p. N is how many seats there are besides p, 1 or
#          more. LANES is how many lanes every pipe has, even and more than
#          zero, and 2 when not given. DEPTH is how many pipes in series
#          every cable through a fitting is, joined by one-outlet tees, 1
#          or more, and 1 when not given; a pipe two seats share is one
#          pipe whatever it is. The numbers are read in base ten, and none
#          may run past 18 significant digits. The pieces come from
#          icc-pipes, icc-tee and icc-merge, beside this skill in the
#          same skills directory; the bay makes nothing but the map.
#          The patch's directory holds two files: patch, the line SHAPE
#          N LANES DEPTH and then one line per end, SEAT SIDE DIR PEERS; and
#          made, one line per piece in the order it was made, its
#          directory and the scripts that made it. bBuilt is empty until
#          a shape's arm has run to its end, and y after.
#          A create that cannot finish hands what it made to its own
#          remove. Once the patch is whole that is no longer armed, so a
#          create that then fails to print leaves a whole patch nobody
#          was told of, which list shows and remove takes.
# @stdin nothing
# @stdout the patch's directory, one line
# @stderr the reason, on refusal, and whatever a piece's scripts say
# @exit 0 the patch is made and printed; 1 the arguments are refused, a
#       piece could not be made, a signal came, or the shape made
#       nothing, and what was made is removed, or it could not be printed
#       and all of it is left
#
# Copyright (c) 2026 Brian Case. All rights reserved.
# AI contributor: Claude (Anthropic)
#
# MIT Licence. See LICENCE.TXT
##
eShape=$1
nSeats=$2
nLanes=${3:-2}
nDepth=${4:-1}
set -eu
source "$(dirname "$0")/../../icc-lib/scripts/lib"
[ $# -ge 2 ] || {
  echo "usage: create SHAPE N [LANES [DEPTH]]" >&2
  exit 1
}
case $eShape in
  star|ring|mesh|ring-p|mesh-p)
    ;;
  *)
    echo "shape is star, ring, mesh, ring-p or mesh-p" >&2
    exit 1
    ;;
esac
# Seats and LANES are counts, taken as icc-lib's nCount takes one: in base
# ten, which both [ and $(( )) then read alike -- the shape counts seats with
# [ and wraps a ring with $(( )). LANES is checked as Pipes' create checks N,
# by nLanesGiven: a shape that makes no pipe still writes LANES into the
# header, and nothing else would say so.
nSeats=$(nCount seats "$nSeats")
[ "$nSeats" -ge 1 ] || {
  echo "seats must be 1 or more" >&2
  exit 1
}
nLanes=$(nLanesGiven "$nLanes")
# DEPTH is a count as seats are, and the loop in vSeries reads it.
nDepth=$(nCount depth "$nDepth")
[ "$nDepth" -ge 1 ] || {
  echo "depth must be 1 or more" >&2
  exit 1
}
pIccPipes=$(cd "$(dirname "$0")/../../icc-pipes/scripts" && pwd)
pIccTee=$(cd "$(dirname "$0")/../../icc-tee/scripts" && pwd)
pIccMerge=$(cd "$(dirname "$0")/../../icc-merge/scripts" && pwd)
# A create that cannot finish takes what it made with it, and exits 1: its
# directory, until the directory holds the two files remove reads, and then
# everything, by remove. Armed before anything is made, as icc-lib's vArm
# says, and armed again for remove once there is something for it to read.
# vPiece swaps the signal traps for its own while a piece is made, and puts
# them back.
pDir=
vArm '[ -n "$pDir" ] && rm -rf "$pDir" || :
      exit 1'
pDir=$(mktemp -d /tmp/icc-patch-XXXXXXXX)
echo "$eShape $nSeats $nLanes $nDepth" > "$pDir/patch"
: > "$pDir/made"
vArm '"$(dirname "$0")/remove" "$pDir"
      exit 1'

##
# @fn vPiece()
# @brief Make one piece with a sibling skill's create, and write it down.
# @details Make a piece and write it down before a signal can part the
#          two. Interrupted between them, create would leave a piece no
#          made file names, which its own list cannot see and its own
#          remove cannot reach. The signal is handled, not ignored: an
#          ignored signal is inherited through fork and exec and cannot
#          be put back by the child, so the hold Pipes starts here would
#          come out deaf to the TERM Pipes' own remove sends it. A
#          handler is reset to default on exec, and this one only sets a
#          flag, so the piece is written down first and the signal
#          honoured after. bSignalled is that flag: empty, and 1 once a
#          signal has come. A failure inside $( ) is not set -e's
#          business here, so each says so itself.
# @param $1 pScripts - the scripts directory of the skill that makes it
# @param $2... - what that skill's create takes
# @stderr what that skill's create says, on refusal
# @global pDir - read, the patch, whose made file it adds a line to
# @global pPiece - set, the directory that skill's create printed
# @global bSignalled - set, whether a signal came while it worked
# @return 0 the piece is made and written down; it exits 1 instead when
#         the piece could not be made, or a signal came while it was
##
vPiece() {
  local pScripts=$1
  shift
  bSignalled=
  trap 'bSignalled=1' INT TERM HUP
  pPiece=$("$pScripts/create" "$@") || exit 1
  # The piece first and its scripts last. A piece is always
  # /tmp/icc-KIND-XXXXXXXX; the scripts are wherever the checkout is, which
  # can hold a space, and read gives its last name the rest of the line.
  echo "$pPiece $pScripts" >> "$pDir/made"
  vStopOnSignal
  [ -z "$bSignalled" ] || exit 1
}

##
# @fn vPipe()
# @brief Make a pipe of nLanes lanes with Pipes' create.
# @global pIccPipes - read, where Pipes' scripts are
# @global nLanes - read, the lanes every pipe in the patch has
# @global pPiece - read, what vPiece made
# @global pPipe - set, the pipe it made
# @return 0; it exits 1 as vPiece does
##
vPipe() {
  vPiece "$pIccPipes" "$nLanes"
  pPipe=$pPiece
}

##
# @fn vTee()
# @brief Make a tee with Tee's create.
# @param $1... - SRC SIDE DST..., as Tee's create takes them
# @global pIccTee - read, where Tee's scripts are
# @return 0; it exits 1 as vPiece does
##
vTee() { vPiece "$pIccTee" "$@"; }

##
# @fn vMerge()
# @brief Make a merge with Merge's create.
# @param $1... - DST SIDE SRC..., as Merge's create takes them
# @global pIccMerge - read, where Merge's scripts are
# @return 0; it exits 1 as vPiece does
##
vMerge() { vPiece "$pIccMerge" "$@"; }

##
# @fn vEnd()
# @brief Write one end into the map.
# @details eSide is 0 or 1. A seat is a number, p for the parent, or -
#          for nobody, and osPeers is seats of the same kinds.
# @param $1 osSeat - the seat that holds it: a number, p, or - for nobody
# @param $2 eSide - the side of the pipe it holds, 0 or 1
# @param $3 pCable - the pipe it is on
# @param $4 osPeers - the seats on the other side, space separated, or -
# @global pDir - read, the patch, whose patch file it adds a line to
# @return 0
##
vEnd() {
  local osSeat=$1
  local eSide=$2
  local pCable=$3
  local osPeers=$4
  echo "$osSeat $eSide $pCable $(echo "$osPeers" | tr ' ' ,)" >> "$pDir/patch"
}

##
# @fn vCable()
# @brief One pipe between two seats, the first on side 0, the other on 1.
# @param $1 osSeatA - the seat on side 0
# @param $2 osSeatB - the seat on side 1
# @global pPipe - read, the pipe vPipe has just made
# @return 0; it exits 1 as vPiece does
##
vCable() {
  local osSeatA=$1
  local osSeatB=$2
  vPipe
  vEnd "$osSeatA" 0 "$pPipe" "$osSeatB"
  vEnd "$osSeatB" 1 "$pPipe" "$osSeatA"
}

##
# @fn vSeries()
# @brief One cable through a fitting: nDepth pipes in series, one way.
# @details What side 0 writes into the head comes out of the tail: each
#          pipe after the first is a one-outlet tee from the one before
#          it, lane for lane, as Tee makes them. A tee carries one way,
#          which is why a pipe two seats share, that each writes and
#          reads, is never one of these. With nDepth 1 the head is the
#          tail and there is no tee. Every pipe in it that no seat holds
#          joins two fittings and nothing else, and goes into the map as
#          such, so the map names every pipe the shape made.
# @param $1 eHeld - which end a seat holds: head, tail, both or none
# @global nDepth - read, how many pipes in series
# @global pPipe - read, what vPipe has just made
# @global pHead - set, the first pipe, which side 0 writes
# @global pTail - set, the last, which side 1 reads
# @return 0; it exits 1 as vPiece does
##
vSeries() {
  local eHeld=$1
  local aChain
  local iPipe
  local pLink
  vPipe
  aChain=("$pPipe")
  for ((iPipe = 1; iPipe < nDepth; iPipe++)); do
    vPipe
    vTee "${aChain[iPipe - 1]}" 0 "$pPipe"
    aChain+=("$pPipe")
  done
  pHead=${aChain[0]}
  pTail=${aChain[nDepth - 1]}
  for pLink in "${aChain[@]}"; do
    case $eHeld in
      head|both)
        [ "$pLink" != "$pHead" ] || continue
        ;;&
      tail|both)
        [ "$pLink" != "$pTail" ] || continue
        ;;
    esac
    vEnd - 1 "$pLink" -
  done
}

osSeats=0
iSeat=1
while [ "$iSeat" -lt "$nSeats" ]; do
  osSeats="$osSeats $iSeat"
  iSeat=$((iSeat + 1))
done
case $eShape in
  star)
    for iSeat in $osSeats; do vCable "$iSeat" p; done
    bBuilt=y
    ;;
  ring)
    case $nSeats in
      1)
        vCable 0 0
        ;;
      2)
        vCable 0 1
        ;;
      *)
        for iSeat in $osSeats; do
          vCable "$iSeat" $(( (iSeat + 1) % nSeats ))
        done
        ;;
    esac
    bBuilt=y
    ;;
  mesh|mesh-p)
    aSeats=($osSeats)
    [ "$eShape" = mesh ] || aSeats+=(p)
    case ${#aSeats[@]} in
      1)
        ;;
      2)
        vCable "${aSeats[0]}" "${aSeats[1]}"
        ;;
      *)
        vPipe
        pBus=$pPipe
        osInlets=
        osOutlets=
        for osSeat in "${aSeats[@]}"; do
          # The seat writes the head of its inlet and the merge reads the
          # tail; the tee writes the head of its outlet and the seat reads
          # the tail.
          vSeries head
          pInlet=$pHead
          osInlets="$osInlets $pTail"
          vSeries tail
          pOutlet=$pTail
          osOutlets="$osOutlets $pHead"
          vEnd "$osSeat" 0 "$pInlet" "${aSeats[*]}"
          vEnd "$osSeat" 1 "$pOutlet" "${aSeats[*]}"
        done
        vMerge "$pBus" 0 $osInlets
        vTee "$pBus" 0 $osOutlets
        vEnd - 1 "$pBus" -
        ;;
    esac
    bBuilt=y
    ;;
  ring-p)
    # On a ring-p 1 p holds the far end of the one seat's cable to it and
    # the near end of its own cable to that seat; on more, a merge and a tee
    # stand between, and those ends are theirs.
    eToParent=none
    eFromParent=tail
    [ "$nSeats" -ne 1 ] || {
      eToParent=tail
      eFromParent=both
    }
    osToParent=
    osFromParent=
    for iSeat in $osSeats; do
      iNext=$(( (iSeat + 1) % nSeats ))
      vSeries head
      pSend=$pHead
      pSendTail=$pTail
      vSeries tail
      pRecvHead=$pHead
      pRecv=$pTail
      vSeries "$eToParent"
      pToParentHead=$pHead
      pToParent=$pTail
      vSeries "$eFromParent"
      pFromParent=$pHead
      pFromParentTail=$pTail
      osToParent="$osToParent $pToParent"
      osFromParent="$osFromParent $pFromParent"
      vEnd "$iSeat" 0 "$pSend" "$iNext p"
      vEnd "$iNext" 1 "$pRecv" "$iSeat"
      vEnd "$iSeat" 1 "$pFromParentTail" p
      vTee "$pSendTail" 0 "$pRecvHead" "$pToParentHead"
    done
    pParentRead=$pToParent
    pParentWrite=$pFromParent
    [ "$nSeats" -eq 1 ] || {
      vSeries tail
      pParentRead=$pTail
      vMerge "$pHead" 0 $osToParent
      vSeries head
      pParentWrite=$pHead
      vTee "$pTail" 0 $osFromParent
    }
    vEnd p 1 "$pParentRead" "$osSeats"
    vEnd p 0 "$pParentWrite" "$osSeats"
    bBuilt=y
    ;;
esac
# An error inside $(( )) is not a command failure, so set -e does not stop it:
# bash abandons the case and lands here. Without this line, "here" is where
# cleanup is disarmed and a directory with no cables in it is reported as one.
[ "${bBuilt:-}" = y ] || {
  echo "made nothing: $eShape $nSeats $nLanes $nDepth" >&2
  exit 1
}
vDisarm
echo "$pDir"
