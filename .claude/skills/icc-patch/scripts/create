#!/bin/bash
# .claude/skills/icc-patch/scripts/create
# create SHAPE N [LANES]: make the pipes, tees and merges SHAPE needs over N
# seats, LANES lanes each (even, default 2), write the map, print the patch's
# directory. The pieces come from icc-pipes, icc-tee and icc-merge, beside
# this skill under .claude/skills; the bay makes nothing but the map.
# Copyright (c) 2026 Brian Case. All rights reserved.
# AI contributor: Claude (Anthropic)
#
# MIT License text omitted for brevity, See LICENCE.TXT
eShape=$1; nSeats=$2; nLanes=${3:-2}
set -eu
[ $# -ge 2 ] || { echo "usage: create SHAPE N [LANES]" >&2; exit 1; }
case $eShape in star|ring|mesh|ring-p|mesh-p) ;;
  *) echo "shape is star, ring, mesh, ring-p or mesh-p" >&2; exit 1;; esac
# [ reads a number decimally and $(( )) reads it C-style, so 010 is ten to one
# of them and eight to the other. Both are used here — the shape counts seats
# with [ and wraps a ring with $(( )) — so force decimal before either sees it.
# Whether lanes are even is Pipes' to say, and it says it when a pipe is made;
# a shape that makes no pipe still writes the header, which is the bay's own.
case $nSeats in ''|*[!0-9]*) echo "seats must be a whole number: $nSeats" >&2; exit 1;; esac
case $nLanes in ''|*[!0-9]*) echo "lanes must be a whole number: $nLanes" >&2; exit 1;; esac
nSeats=$((10#$nSeats)); nLanes=$((10#$nLanes))
[ "$nSeats" -ge 1 ] || { echo "seats must be 1 or more" >&2; exit 1; }
pTop=$(cd "$(dirname "$0")/../../../.." && pwd)
pIccPipes=$(cd "$pTop/.claude/skills/icc-pipes/scripts" && pwd)
pIccTee=$(cd "$pTop/.claude/skills/icc-tee/scripts" && pwd)
pIccMerge=$(cd "$pTop/.claude/skills/icc-merge/scripts" && pwd)
pDir=$(mktemp -d /tmp/icc-patch-XXXXXXXX)
trap 'rm -rf "$pDir"' EXIT
echo "$eShape $nSeats $nLanes" > "$pDir/patch"; : > "$pDir/made"
trap '"$(dirname "$0")/remove" "$pDir"' EXIT
# Make a piece and write it down before a signal can part the two. Interrupted
# between them, create would leave a piece no made file names, which its own
# list cannot see and its own remove cannot reach. The signal is handled, not
# ignored: an ignored signal is inherited through fork and exec and cannot be
# put back by the child, so the hold Pipes starts here would come out deaf to
# the TERM Pipes' own remove sends it. A handler is reset to default on exec,
# and this one only sets a flag, so the piece is written down first and the
# signal honoured after. A failure inside $( ) is not set -e's business here,
# so each says so itself.
vPiece() { local pScripts=$1; shift
  bSignalled=; trap 'bSignalled=1' INT TERM HUP
  pPiece=$("$pScripts/create" "$@") || exit 1
  echo "$pScripts $pPiece" >> "$pDir/made"
  trap - INT TERM HUP
  [ -z "$bSignalled" ] || exit 1
}
vPipe() { vPiece "$pIccPipes" "$nLanes"; pPipe=$pPiece; }
vTee() { vPiece "$pIccTee" "$@"; }
vMerge() { vPiece "$pIccMerge" "$@"; }
vEnd() { local osSeat=$1 eSide=$2 pCable=$3 osPeers=$4
  echo "$osSeat $eSide $pCable $(echo "$osPeers" | tr ' ' ,)" >> "$pDir/patch"; }
vCable() {  # vCable A B: one pipe, seat A on side 0, seat B on side 1
  local osSeatA=$1 osSeatB=$2
  vPipe; vEnd "$osSeatA" 0 "$pPipe" "$osSeatB"; vEnd "$osSeatB" 1 "$pPipe" "$osSeatA"
}
osSeats=0; iSeat=1; while [ "$iSeat" -lt "$nSeats" ]; do osSeats="$osSeats $iSeat"; iSeat=$((iSeat + 1)); done
case $eShape in
  star) for iSeat in $osSeats; do vCable "$iSeat" p; done; bBuilt=y ;;
  ring)
    case $nSeats in 1) vCable 0 0 ;; 2) vCable 0 1 ;;
      *) for iSeat in $osSeats; do vCable "$iSeat" $(( (iSeat + 1) % nSeats )); done ;; esac
    bBuilt=y ;;
  mesh|mesh-p)
    set -- $osSeats; [ "$eShape" = mesh ] || set -- "$@" p
    case $# in 1) ;; 2) vCable "$1" "$2" ;;
      *) vPipe; pBus=$pPipe; osInlets=; osOutlets=
         for osSeat; do vPipe; pInlet=$pPipe; vPipe; pOutlet=$pPipe; osInlets="$osInlets $pInlet"; osOutlets="$osOutlets $pOutlet"
           vEnd "$osSeat" 0 "$pInlet" "$*"; vEnd "$osSeat" 1 "$pOutlet" "$*"; done
         vMerge "$pBus" 0 $osInlets; vTee "$pBus" 0 $osOutlets; vEnd - 1 "$pBus" - ;; esac
    bBuilt=y ;;
  ring-p)
    osToParent=; osFromParent=
    for iSeat in $osSeats; do iNext=$(( (iSeat + 1) % nSeats ))
      vPipe; pSend=$pPipe; vPipe; pRecv=$pPipe; vPipe; pToParent=$pPipe; vPipe; pFromParent=$pPipe
      osToParent="$osToParent $pToParent"; osFromParent="$osFromParent $pFromParent"
      vEnd "$iSeat" 0 "$pSend" "$iNext p"; vEnd "$iNext" 1 "$pRecv" "$iSeat"; vEnd "$iSeat" 1 "$pFromParent" p
      vTee "$pSend" 0 "$pRecv" "$pToParent"
    done
    pParentRead=$pToParent; pParentWrite=$pFromParent
    [ "$nSeats" -eq 1 ] || { vPipe; pParentRead=$pPipe; vMerge "$pParentRead" 0 $osToParent; vPipe; pParentWrite=$pPipe; vTee "$pParentWrite" 0 $osFromParent
      for pCoupler in $osToParent; do vEnd - 1 "$pCoupler" -; done; }
    vEnd p 1 "$pParentRead" "$osSeats"; vEnd p 0 "$pParentWrite" "$osSeats"; bBuilt=y ;;
esac
# An error inside $(( )) is not a command failure, so set -e does not stop it:
# bash abandons the case and lands here. Without this line, "here" is where
# cleanup is disarmed and a directory with no cables in it is reported as one.
[ "${bBuilt:-}" = y ] || { echo "made nothing: $eShape $nSeats $nLanes" >&2; exit 1; }
trap - EXIT
echo "$pDir"
