#!/bin/bash
##
# @file list
# @brief One line per patch: its directory, up or down, and its header.
# @details list takes nothing. A patch is a /tmp/icc-patch-* directory
#          whose patch file has a first line. eState is up or down: up
#          when every piece its made file names is listed up by that
#          piece's own skill, and down otherwise. A patch whose made file
#          is gone is down: nothing can say its pieces are up, and its
#          pieces cannot be reached to remove.
# @stdin nothing
# @stdout "DIR up|down SHAPE N LANES", one line per patch, in glob order
# @stderr whatever a piece's own list says
# @exit 0, with patches or without; 1 cut off by a signal
#
# Copyright (c) 2026 Brian Case. All rights reserved.
# AI contributor: Claude (Anthropic)
#
# MIT Licence. See LICENCE.TXT
##
set -eu
# Ask each skill once what it has, not once per piece it has: a sibling's list
# names every piece of its kind on the box, so asking per piece makes listing
# one patch cost as much as everyone else's work put together.
# The temp file goes however this ends, and a signal ends it with 1.
# Armed before anything is made, as in every piece: a name is empty until
# what it names exists, and bash runs a caught signal only once the $( ) that
# makes a thing, and its assignment, are done, so the handler always knows
# what there is to take. A signal exits 1, which runs the handler.
pListed=
trap '[ -n "$pListed" ] && rm -f "$pListed" || :' EXIT
trap 'exit 1' INT TERM HUP
pListed=$(mktemp)
cut -d' ' -f2- /tmp/icc-patch-*/made 2>/dev/null | sort -u |
  while read -r pScripts; do
    [ -x "$pScripts/list" ] && "$pScripts/list" | cut -d' ' -f1,2
  done > "$pListed" || :
# A patch can go while this runs. That is a normal thing on a shared box, not
# an error: read each file once, and skip a patch that is no longer there.
for pDir in /tmp/icc-patch-*/; do
  pDir=${pDir%/}
  osHeader=$(sed -n 1p "$pDir/patch" 2>/dev/null) || osHeader=
  [ -n "$osHeader" ] || continue
  if osMade=$(cat "$pDir/made" 2>/dev/null); then
    eState=up
    [ -z "$osMade" ] || while read -r pPiece pScripts; do
      grep -qxF "$pPiece up" "$pListed" || eState=down
    done <<< "$osMade"
  else
    eState=down
  fi
  echo "$pDir $eState $osHeader"
done
