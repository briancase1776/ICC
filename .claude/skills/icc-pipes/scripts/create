#!/bin/bash
##
# @file create
# @brief Make a fresh pipe of N lanes, hold every lane open, print it.
# @details create [N]. N is how many lanes, even and more than zero, read
#          in base ten and no more than 18 significant digits, and 2 when
#          it is not given. A pipe is a directory holding a fifo per lane,
#          named 0 to N-1, and a pid file naming the hold: a sleep that
#          keeps every lane open, so nothing blocks on open, and ignores a
#          hangup, as a server does. Even lanes go one way, odd lanes the
#          other.
#          A create that cannot finish takes its directory and its hold
#          with it. Once the pipe is whole that is no longer armed, so a
#          create that then fails to print leaves a whole pipe nobody
#          was told of, which list shows and remove takes.
# @stdin nothing
# @stdout the pipe's directory, one line
# @stderr the reason, on refusal
# @exit 0 the pipe is made and printed; 1 N is refused, or the pipe
#       could not be finished and none of it is left, or it could not
#       be printed and all of it is
#
# Copyright (c) 2026 Brian Case. All rights reserved.
# AI contributor: Claude (Anthropic)
#
# MIT Licence. See LICENCE.TXT
##
nLanes=${1-2}
set -eu
# A lane count is checked one way wherever one is given, here and in Patch's
# create, line for line: digits only, parity from the last digit, no more
# digits than 64 bits always hold, then base ten, then more than zero. $(( ))
# reads a leading zero as octal and [ does not, and two readings of the count
# is what once let an odd one past; forcing base ten leaves one.
case $nLanes in
  ''|*[!0-9]*)
    echo "lanes must be a whole number: $nLanes" >&2
    exit 1
    ;;
  *[13579])
    echo "lanes must be even: $nLanes" >&2
    exit 1
    ;;
esac
[[ $nLanes =~ ^0*[0-9]{1,18}$ ]] || {
  echo "lanes too big: $nLanes" >&2
  exit 1
}
nLanes=$((10#$nLanes))
[ "$nLanes" -gt 0 ] || {
  echo "lanes must be more than zero" >&2
  exit 1
}
# Until the pipe is whole, it is not a pipe: a create that cannot finish
# takes its directory with it, and its hold if one started, and exits 1.
# Armed before anything is made, as in every piece: a name is empty until
# what it names exists, and bash runs a caught signal only once the $( ) that
# makes a thing, and its assignment, are done, so the handler always knows
# what there is to take. A signal exits 1, which runs the handler.
# pidHold stays empty until there is a hold, because kill 0 would signal the
# process group.
pDir=
pidHold=
trap '[ -n "$pidHold" ] && kill "$pidHold" 2>/dev/null || :
      [ -n "$pDir" ] && rm -rf "$pDir" || :
      exit 1' EXIT
trap 'exit 1' INT TERM HUP
pDir=$(mktemp -d /tmp/icc-pipes-XXXXXXXX)
osRedirs=
iLane=0
while [ "$iLane" -lt "$nLanes" ]; do
  mkfifo "$pDir/$iLane"
  osRedirs="$osRedirs $((iLane + 3))<>'$pDir/$iLane'"
  iLane=$((iLane + 1))
done
# Open the lanes here, where a failure is this shell's own and stops it. The
# hold is started after and inherits them: opening them in the background
# instead made create report success whatever became of the opens, so a pipe
# whose hold never opened a lane was printed, and blocked on first write.
eval "exec $osRedirs"
# The hold clears the traps above and execs, as every server here does. It
# is a server: it serves whoever holds the pipe's ends long after this create,
# and whoever ran it, are gone, so a hangup is not its business. It ignores
# HUP, as a server run under nohup does; TERM, which remove sends, still ends
# it.
(
  trap - EXIT INT TERM
  trap '' HUP
  exec sleep infinity
) </dev/null >/dev/null 2>&1 &
pidHold=$!
echo "$pidHold" > "$pDir/pid"
trap - EXIT INT TERM HUP
echo "$pDir"
