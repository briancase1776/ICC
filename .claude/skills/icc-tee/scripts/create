#!/bin/bash
##
# @file create
# @brief Copy what SIDE writes into SRC onto every DST, and print the tee.
# @details create SRC SIDE DST... SRC and every DST are pipes Pipes made,
#          all with the same even lane count, every lane of them a fifo.
#          SIDE is 0 or 1, the side whose writes are copied. No DST is SRC
#          and none is given twice, in any spelling. For each lane SIDE
#          writes, a copier, tee(1), takes that lane of SRC and writes it
#          to that lane of every DST, byte for byte, in order, until
#          removed; a copier ignores a hangup, as a server does. The tee's
#          directory holds two files: tee, naming SRC, SIDE and each DST a
#          line, and pid, one copier a line in lane order, written empty
#          before the first copier is forked. The tee makes nothing but
#          itself.
#          A create that cannot finish, or whose directory is removed
#          while it starts, takes its copiers and its two files with it,
#          and its directory unless something else is in it. The
#          directory is printed the moment it is made, as icc-lib's
#          pMakeDir does it, so a create that fails after has already
#          said what it made.
# @stdin nothing
# @stdout the tee's directory, one line, as soon as it is made
# @stderr the reason, on refusal
# @exit 0 the tee is made; 1 the arguments are refused, or the tee could
#       not be finished or was removed while it started, and none of it
#       is left
#
# Copyright (c) 2026 Brian Case. All rights reserved.
# AI contributor: Claude (Anthropic)
#
# MIT Licence. See LICENCE.TXT
##
pSrc=$1
eSide=$2
set -eu
source "$(dirname "$0")/../../icc-lib/scripts/lib"
[ $# -ge 3 ] || {
  echo "usage: create SRC SIDE DST..." >&2
  exit 1
}
shift 2
vSide "$eSide"
# A pipe is what Pipes makes: SRC and every DST are checked as icc-lib's
# nLanesOf checks them, which is how Merge's create and Frames' read and
# write check theirs. A numeric entry that is not a lane would count toward
# the count, and then its copier would append to it as a file, or read it
# as one and end.
nLanes=$(nLanesOf "$pSrc" "$@")
# Canonicalise before anything compares or is written: one pipe has many
# spellings, the checks below are comparisons, and the outlets go in the
# copiers' argv, which SKILL.md tells the caller pkill finds and list prints.
pSrc=$(readlink -f -- "$pSrc")
aDsts=()
for pPipe; do
  pDst=$(readlink -f -- "$pPipe")
  # SRC as its own DST copies a lane back into itself and spins on one byte
  # forever. The same DST twice writes every byte to that lane twice, count
  # line and all, so a Frames read there yields something nobody sent.
  [ "$pDst" != "$pSrc" ] || {
    echo "DST is SRC: $pPipe" >&2
    exit 1
  }
  for pSeen in "${aDsts[@]}"; do
    [ "$pDst" != "$pSeen" ] || {
      echo "DST twice: $pPipe" >&2
      exit 1
    }
  done
  aDsts+=("$pDst")
done
# Until the tee is whole it is not a tee: a create that cannot finish takes
# its directory with it, and the copiers it started, and exits 1. Armed
# before anything is made, as icc-lib's vArm says. aPids stays empty until
# there is a copier, because kill with no pid is not this shell's to send.
# The handler takes the two files create writes and rmdirs, never rm -rf, so
# a directory that holds anything else is left where it is and says so.
pDir=
aPids=()
vArm '[ ${#aPids[@]} -eq 0 ] || kill "${aPids[@]}" 2>/dev/null || :
      if [ -n "$pDir" ]; then
        rm -f "$pDir/tee" "$pDir/pid"
        rmdir "$pDir" 2>/dev/null || [ ! -d "$pDir" ] ||
          echo "left in place: $pDir" >&2
      fi
      exit 1'
pMakeDir icc-tee
{
  printf '%s\n' "$pSrc" "$eSide"
  printf '%s\n' "${aDsts[@]}"
} > "$pDir/tee"
# Both files from here on, so a tee is the same shape to list and to remove
# before the first copier is forked as after, as Merge's is.
: > "$pDir/pid"
iLane=$eSide
while [ "$iLane" -lt "$nLanes" ]; do
  aOuts=()
  for pDst in "${aDsts[@]}"; do aOuts+=("$pDst/$iLane"); done
  # A copier is a server, started as icc-lib's vServe says, and then tee(1)
  # and nothing else.
  # Let go of the caller's stdout before opening the lane, not with it: a
  # lane whose pipe has no writer blocks the open, and a copier still
  # holding what it inherited held d=$(create ...) open with it. Its own
  # output goes nowhere either way; only the order matters.
  # Until the lane opens, a copier is a shell with create's argv and nothing
  # on stdin to be known by, so while it waits it holds this tee's own tee
  # file on fd 3, which nothing else holds: remove finds a waiting copier by
  # that, as it finds a copying one by its lane on stdin. The lane is opened
  # before fd 3 is closed, so the mark lasts as long as the wait, and tee(1)
  # does not inherit it.
  (
    vServe
    exec >/dev/null 2>&1 3< "$pDir/tee"
    exec tee -a -- "${aOuts[@]}" < "$pSrc/$iLane" 3<&-
  ) &
  aPids+=($!)
  echo $! >> "$pDir/pid"
  iLane=$((iLane + 2))
done
# Still ours? A remove that ran while the loop above forked took the
# directory, and the copiers already started are copying for a tee that no
# longer exists, which nothing can list and nothing can stop. They are this
# shell's to end, and the handler ends them.
[ -d "$pDir" ] && [ -f "$pDir/tee" ] && [ -f "$pDir/pid" ] || {
  echo "removed while starting: $pDir" >&2
  exit 1
}
vDisarm
