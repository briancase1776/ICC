#!/bin/bash
# .claude/skills/icc-tee/scripts/create
# create SRC SIDE DST...: copy what SIDE writes into pipe SRC onto the same
# lanes of every pipe DST, byte for byte, in order, until removed. Print the
# tee's directory. Every pipe must exist and have the same lane count; the
# tee makes nothing but itself.
# Copyright (c) 2026 Brian Case. All rights reserved.
# AI contributor: Claude (Anthropic)
#
# MIT License text omitted for brevity, See LICENCE.TXT
pSrc=$1; eSide=$2
set -eu
[ $# -ge 3 ] || { echo "usage: create SRC SIDE DST..." >&2; exit 1; }
shift 2
[ "$eSide" = 0 ] || [ "$eSide" = 1 ] || { echo "side is 0 or 1" >&2; exit 1; }
for pPipe in "$pSrc" "$@"; do
  [ -p "$pPipe/0" ] || { echo "not a pipe: $pPipe" >&2; exit 1; }
done
# Canonicalise before anything compares or is written: one pipe has many
# spellings, the checks below are comparisons, and the outlets go in the
# copiers' argv, which SKILL.md tells the caller pkill finds and list prints.
pSrc=$(readlink -f -- "$pSrc")
aDsts=()
for pPipe; do
  pDst=$(readlink -f -- "$pPipe")
  # SRC as its own DST copies a lane back into itself and spins on one byte
  # forever. The same DST twice writes every byte to that lane twice, count
  # line and all, so a Frames read there yields something nobody sent.
  [ "$pDst" != "$pSrc" ] || { echo "DST is SRC: $pPipe" >&2; exit 1; }
  for pSeen in "${aDsts[@]}"; do
    [ "$pDst" != "$pSeen" ] || { echo "DST twice: $pPipe" >&2; exit 1; }
  done
  aDsts+=("$pDst")
done
nLanes=$(ls "$pSrc" | grep -c '^[0-9][0-9]*$')
for pDst in "${aDsts[@]}"; do
  [ "$(ls "$pDst" | grep -c '^[0-9][0-9]*$')" -eq "$nLanes" ] ||
    { echo "lanes differ: $pDst" >&2; exit 1; }
done
pDir=$(mktemp -d /tmp/icc-tee-XXXXXXXX)
# Until the tee is whole it is not a tee: a create that cannot finish takes
# its directory with it, and the copiers it started. aPids stays empty until
# there is one, because kill with no pid is not this shell's to send. The
# handler takes the two files create writes and rmdirs, never rm -rf, so a
# directory that holds anything else is left where it is and says so. It
# exits: without that, a signal caught between the last copier and the
# disarm would clean up and let create print the path it just deleted.
aPids=()
trap 'trap - EXIT INT TERM HUP
      [ ${#aPids[@]} -eq 0 ] || kill "${aPids[@]}" 2>/dev/null || :
      rm -f "$pDir/tee" "$pDir/pid"
      rmdir "$pDir" 2>/dev/null || [ ! -d "$pDir" ] || echo "left in place: $pDir" >&2
      exit 1' EXIT INT TERM HUP
{ printf '%s\n' "$pSrc" "$eSide"; printf '%s\n' "${aDsts[@]}"; } > "$pDir/tee"
iLane=$eSide
while [ "$iLane" -lt "$nLanes" ]; do
  aOuts=(); for pDst in "${aDsts[@]}"; do aOuts+=("$pDst/$iLane"); done
  # A copier is this shell's child until it execs, so it inherits the traps
  # above: killing one from the handler ran the handler again, in it, racing
  # the shell that sent the signal. Clear them and exec, so a copier is
  # tee(1) and nothing else.
  # Let go of the caller's stdout before opening the lane, not with it: a
  # lane whose pipe has no writer blocks the open, and a copier still
  # holding what it inherited held d=$(create ...) open with it. Its own
  # output goes nowhere either way; only the order matters.
  ( trap - EXIT INT TERM HUP
    exec >/dev/null 2>&1
    exec tee -a -- "${aOuts[@]}" < "$pSrc/$iLane" ) &
  aPids+=($!)
  echo $! >> "$pDir/pid"
  iLane=$((iLane + 2))
done
trap - EXIT INT TERM HUP
echo "$pDir"
