#!/bin/bash
##
# @file create
# @brief Copy what SIDE writes into SRC onto every DST, and print the tee.
# @details create SRC SIDE DST... SRC and every DST are pipes Pipes made,
#          all with the same lane count, every lane of them a fifo, and a
#          lane for SIDE among them. SIDE is 0 or 1, the side whose
#          writes are copied. No DST is SRC and none is given twice, in
#          any spelling. For each lane SIDE writes, a copier, tee(1),
#          takes that lane of SRC and writes it to that lane of every
#          DST, byte for byte, in order, until removed. The tee's
#          directory holds two files: tee, naming SRC, SIDE and each DST
#          a line, and pid, one copier a line in lane order, written empty
#          before the first copier is forked. The tee makes nothing but
#          itself.
#          A create that cannot finish, or whose directory is removed
#          while it starts, takes its copiers and its two files with it,
#          and its directory unless something else is in it. Once the
#          tee is whole that is no longer armed, so a create that then
#          fails to print leaves a whole tee nobody was told of, which
#          list shows and remove takes.
# @stdin nothing
# @stdout the tee's directory, one line
# @stderr the reason, on refusal
# @exit 0 the tee is made and printed; 1 the arguments are refused, or
#       the tee could not be finished or was removed while it started,
#       and none of it is left, or it could not be printed and all of it
#       is
#
# Copyright (c) 2026 Brian Case. All rights reserved.
# AI contributor: Claude (Anthropic)
#
# MIT Licence. See LICENCE.TXT
##
pSrc=$1
eSide=$2
set -eu
[ $# -ge 3 ] || {
  echo "usage: create SRC SIDE DST..." >&2
  exit 1
}
shift 2
[ "$eSide" = 0 ] || [ "$eSide" = 1 ] || {
  echo "side is 0 or 1" >&2
  exit 1
}
# A pipe is what Pipes makes, and the same checks, in the same order, as
# Merge's create: lane 0 of every pipe first, so a path that is no pipe at
# all says so; then a lane for SIDE to copy, or the tee would start no
# copier; then every pipe the same count, and every lane of it a lane. A
# numeric entry that is not a lane counts toward the count, and then its
# copier appends to it as a file, or reads it as one and ends.
for pPipe in "$pSrc" "$@"; do
  [ -p "$pPipe/0" ] || {
    echo "not a pipe: $pPipe" >&2
    exit 1
  }
done
nLanes=$(ls -- "$pSrc" | grep -c '^[0-9][0-9]*$')
[ "$nLanes" -gt "$eSide" ] || {
  echo "no lane for SIDE $eSide: $pSrc" >&2
  exit 1
}
for pPipe in "$pSrc" "$@"; do
  [ "$(ls -- "$pPipe" | grep -c '^[0-9][0-9]*$')" -eq "$nLanes" ] || {
    echo "lanes differ: $pPipe" >&2
    exit 1
  }
  iLane=0
  while [ "$iLane" -lt "$nLanes" ]; do
    [ -p "$pPipe/$iLane" ] || {
      echo "not a pipe: $pPipe" >&2
      exit 1
    }
    iLane=$((iLane + 1))
  done
done
# Canonicalise before anything compares or is written: one pipe has many
# spellings, the checks below are comparisons, and the outlets go in the
# copiers' argv, which SKILL.md tells the caller pkill finds and list prints.
pSrc=$(readlink -f -- "$pSrc")
aDsts=()
for pPipe; do
  pDst=$(readlink -f -- "$pPipe")
  # SRC as its own DST copies a lane back into itself and spins on one byte
  # forever. The same DST twice writes every byte to that lane twice, count
  # line and all, so a Frames read there yields something nobody sent.
  [ "$pDst" != "$pSrc" ] || {
    echo "DST is SRC: $pPipe" >&2
    exit 1
  }
  for pSeen in "${aDsts[@]}"; do
    [ "$pDst" != "$pSeen" ] || {
      echo "DST twice: $pPipe" >&2
      exit 1
    }
  done
  aDsts+=("$pDst")
done
pDir=$(mktemp -d /tmp/icc-tee-XXXXXXXX)
# Until the tee is whole it is not a tee: a create that cannot finish takes
# its directory with it, and the copiers it started. aPids stays empty until
# there is one, because kill with no pid is not this shell's to send. The
# handler takes the two files create writes and rmdirs, never rm -rf, so a
# directory that holds anything else is left where it is and says so. It
# exits: without that, a signal caught between the last copier and the
# disarm would clean up and let create print the path it just deleted.
aPids=()
trap 'trap - EXIT INT TERM HUP
      [ ${#aPids[@]} -eq 0 ] || kill "${aPids[@]}" 2>/dev/null || :
      rm -f "$pDir/tee" "$pDir/pid"
      rmdir "$pDir" 2>/dev/null || [ ! -d "$pDir" ] ||
        echo "left in place: $pDir" >&2
      exit 1' EXIT INT TERM HUP
{
  printf '%s\n' "$pSrc" "$eSide"
  printf '%s\n' "${aDsts[@]}"
} > "$pDir/tee"
# Both files from here on, so a tee is the same shape to list and to remove
# before the first copier is forked as after, as Merge's is.
: > "$pDir/pid"
iLane=$eSide
while [ "$iLane" -lt "$nLanes" ]; do
  aOuts=()
  for pDst in "${aDsts[@]}"; do aOuts+=("$pDst/$iLane"); done
  # A copier is this shell's child until it execs, so it inherits the traps
  # above: killing one from the handler ran the handler again, in it, racing
  # the shell that sent the signal. Clear them and exec, so a copier is
  # tee(1) and nothing else.
  # Let go of the caller's stdout before opening the lane, not with it: a
  # lane whose pipe has no writer blocks the open, and a copier still
  # holding what it inherited held d=$(create ...) open with it. Its own
  # output goes nowhere either way; only the order matters.
  # Until the lane opens, a copier is a shell with create's argv and nothing
  # on stdin to be known by, so while it waits it holds this tee's own tee
  # file on fd 3, which nothing else holds: remove finds a waiting copier by
  # that, as it finds a copying one by its lane on stdin. The lane is opened
  # before fd 3 is closed, so the mark lasts as long as the wait, and tee(1)
  # does not inherit it.
  (
    trap - EXIT INT TERM HUP
    exec >/dev/null 2>&1 3< "$pDir/tee"
    exec tee -a -- "${aOuts[@]}" < "$pSrc/$iLane" 3<&-
  ) &
  aPids+=($!)
  echo $! >> "$pDir/pid"
  iLane=$((iLane + 2))
done
# Still ours? A remove that ran while the loop above forked took the
# directory, and the copiers already started are copying for a tee that no
# longer exists, which nothing can list and nothing can stop. They are this
# shell's to end, and the handler ends them.
[ -d "$pDir" ] && [ -f "$pDir/tee" ] && [ -f "$pDir/pid" ] || {
  echo "removed while starting: $pDir" >&2
  exit 1
}
trap - EXIT INT TERM HUP
echo "$pDir"
