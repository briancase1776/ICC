#!/bin/bash
# .claude/skills/icc-tee/scripts/list
# list: one line per tee, "DIR up|down SRC SIDE DST...".
# Up means every lane's copier still has its lane of SRC open to read.
# Copyright (c) 2026 Brian Case. All rights reserved.
# AI contributor: Claude (Anthropic)
#
# MIT License text omitted for brevity, See LICENCE.TXT
for pDir in /tmp/icc-tee-*/; do
  [ -d "$pDir" ] || continue
  pDir=${pDir%/}
  # A directory matching the glob with no DIR/tee in it was not made here, or
  # was not finished. Announcing it printed a line with no SRC, SIDE or DST
  # in it and three errors on stderr.
  [ -f "$pDir/tee" ] || continue
  pSrc=$(sed -n 1p "$pDir/tee"); iLane=$(sed -n 2p "$pDir/tee")
  eState=up
  for pidCopier in $(cat "$pDir/pid" 2>/dev/null); do
    [ "$(readlink "/proc/$pidCopier/fd/0" 2>/dev/null)" = "$pSrc/$iLane" ] || eState=down
    iLane=$((iLane + 2))
  done
  echo "$pDir $eState $(paste -sd ' ' < "$pDir/tee")"
done
