#!/bin/bash
##
# @file list
# @brief One line per tee: its directory, up or down, and its tee file.
# @details list takes nothing. A tee is a /tmp/icc-tee-* directory with a
#          tee file in it whose SIDE is 0 or 1; anything else is skipped.
#          eState is up or down: up when the pid file names at least one
#          copier and every one of them still has its lane of SRC open on
#          fd 0, counting lanes from SIDE in steps of two, and down
#          otherwise.
# @stdin nothing
# @stdout "DIR up|down SRC SIDE DST...", one line per tee, in glob order
# @stderr nothing
# @exit 0, with tees or without
#
# Copyright (c) 2026 Brian Case. All rights reserved.
# AI contributor: Claude (Anthropic)
#
# MIT Licence. See LICENCE.TXT
##
for pDir in /tmp/icc-tee-*/; do
  [ -d "$pDir" ] || continue
  pDir=${pDir%/}
  # A directory matching the glob with no DIR/tee in it was not made here, or
  # was not finished. Announcing it printed a line with no SRC, SIDE or DST
  # in it and three errors on stderr.
  [ -f "$pDir/tee" ] || continue
  pSrc=$(sed -n 1p "$pDir/tee")
  iLane=$(sed -n 2p "$pDir/tee")
  # A SIDE that is not 0 or 1 was not written by create either. It goes into
  # arithmetic below, where it stopped the listing, or ran what a subscript
  # in it spelled.
  case $iLane in
    0|1)
      ;;
    *)
      continue
      ;;
  esac
  # Down until every copier answers, the way Pipes reads a hold and Merge its
  # copiers: a tee with no copiers yet, or none left, is not up, and only a
  # positive check says otherwise.
  eState=down
  nCopiers=0
  nUp=0
  for pidCopier in $(cat "$pDir/pid" 2>/dev/null); do
    [ "$(readlink "/proc/$pidCopier/fd/0" 2>/dev/null)" = "$pSrc/$iLane" ] &&
      nUp=$((nUp + 1))
    nCopiers=$((nCopiers + 1))
    iLane=$((iLane + 2))
  done
  [ "$nCopiers" -gt 0 ] && [ "$nUp" -eq "$nCopiers" ] && eState=up
  echo "$pDir $eState $(paste -sd ' ' < "$pDir/tee")"
done
